{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gage publish definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["session"],
  "properties": {
    "session": {"type": "string"},
    "init": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audience": {"type": "string"},
        "use": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "array",
            "prefixItems": [{"type": "string"}, {"type": "string"}],
            "items": false,
            "minItems": 2
          }
        ]
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": ["string", "null"]},
          {"type": "string"},
          {"type": "string"}
        ],
        "items": false,
        "minItems": 3
      }
    },
    "allow": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [{"type": "string"}, {"type": "string"}],
        "items": false,
        "minItems": 2
      }
    },
    "redact": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string", "minLength": 1},
          {"type": "string"},
          {"type": ["string", "boolean"]},
          {"type": "boolean"}
        ],
        "items": false,
        "minItems": 3
      }
    }
  }
}

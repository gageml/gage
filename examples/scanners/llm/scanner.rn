use gage::{call_llm, PollResult::Tool};

pub const SCANNER = #{
    name: "test-llm",
    hidden: true,
    description: "Test LLM calls",
    tasks: #{ hello: #{}, tool: #{} },
};

pub async fn hello() {
    let llm = call_llm("Say hello").model("small").await?;
    while llm.active() {
        println!("## hello # {:?}", llm.poll().await?);
    }
}

pub async fn tool() {
    let llm = call_llm("What's the secret")
        .model("small")
        .tool("Secret", #{ description: "Get a secret", inputs: [] })
        .await?;
    while llm.active() {
        match llm.poll().await? {
            Tool("Secret", #{}, id) => {
                llm.tool_result(id, "Abc123")
            }
            other => println!("## tool # {other:?}"),
        }
    }
}

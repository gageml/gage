use gage::{Ignore, scan, write_issue, write_note};

pub const SCANNER = #{
    name: "write-issue",
    description: "Demonstrate issue writing with note dep",
    tasks: #{
        scan_note: #{ notes: #{ writes: #{ "foo": "Sample note" } } },
        session_note: #{ notes: #{ writes: #{ "bar": "Sample note" } } },
        issue_keep_status: #{
            notes: #{ wants: ["bar"] },
            issues: #{ writes: #{ "baz": "A non-issue" } },
        },
        issue_pending: #{ issues: #{ writes: #{ "bam": "A non-issue" } } },
    },
};

pub async fn scan_note() {
    write_note(#{ name: "foo", value: "Hi foo", target: #{ scan: scan().id } })
        .replace_prev()
        .await?
}

pub async fn session_note() {
    if let Some(s) = scan().sessions().next() {
        if let Some(m) = s.messages().await?.iter().next() {
            write_note(
                #{
                    name: "bar",
                    value: "Hi bar",
                    target: #{ session: s.id, line: m.line },
                },
            )
            .replace_prev()
            .await?;
        }
    }
    Ok(())
}

pub async fn issue_keep_status() {
    let note = scan().notes().name("baz").await?.get(0).ok_or(Ignore)?;
    write_issue(
        #{
            name: "test.baz",
            title: "Found baz note",
            description: format!("baz note value: {}", note.value),
        },
    )
    .keep_status()
    .await?
}

pub async fn issue_pending() {
    write_issue(
        #{
            name: "test.bam",
            title: "Sample issues written as pending",
            pending: true,
        },
    )
    .keep_status()
    .await?
}

use gage::{Ignore, scan, write_issue, write_note};

pub const SCANNER = #{
    name: "write-issue",
    description: "Demonstrate issue writing with note dep",
    tasks: #{
        note: #{ notes: #{ writes: #{ "baz": "Sample note" } } },
        issue_keep_status: #{
            notes: #{ wants: ["baz"] },
            issues: #{ writes: #{ "test.baz": "A non-issue" } },
        },
        issue_pending: #{
            issues: #{ writes: #{ "test.bam": "A non-issue" } },
        },
    },
};

pub async fn note() {
    write_note(#{ name: "baz", value: "Hi baz", target: #{ scan: scan().id } })
        .replace_prev()
        .await?
}

pub async fn issue_keep_status() {
    let note = scan().notes().name("baz").await?.get(0).ok_or(Ignore)?;
    write_issue(
        #{
            name: "test.baz",
            title: "Found baz note",
            description: format!("baz note value: {}", note.value),
        },
    )
    .keep_status()
    .await?
}

pub async fn issue_pending() {
    write_issue(
        #{
            name: "test.bam",
            title: "Sample issues written as pending",
            pending: true,
        },
    )
    .keep_status()
    .await?
}

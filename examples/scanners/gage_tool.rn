use gage::{call_agent, scan, tools::NoteWrite};

pub const SCANNER = #{
    name: "gage-tool",
    description: "Sample use of Gage tool",
    tasks: #{ comment: #{}, named: #{} },
};

/// Write a comment using Gage NoteWrite tool.
pub async fn comment() {
    let agent = call_agent(
        "Write a comment 'Hello, Joe' with the NoteWrite tool.",
    )
    .gage_tools([NoteWrite::new().scan(scan().id)])
    .model("medium")
    .await?;
    let result = agent.wait().await?;
    log::info!("write comment result: {result:?}");
}

/// Write a note named based on prompt
pub async fn named() {
    let choice = if rand::rng().random::<f64>() > 0.5 {
        "Mike"
    } else {
        "Robert"
    };
    let prompt = format!(
        "Say hello to {choice} using the NoteWrite tool."
    );
    let agent = call_agent(prompt)
        .gage_tools(
            [
                NoteWrite::new()
                    .scan(scan().id)
                    .names(
                        #{
                            "msg.mike": "Message to Mike",
                            "msg.robert": "Message to Robert",
                        },
                    ),
            ],
        )
        .await?;
    let result = agent.wait().await?;
    log::info!("write named note result: {result:?}");
}

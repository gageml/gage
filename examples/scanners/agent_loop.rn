use gage::{Event, call_agent};

pub const SCANNER = #{
    name: "agent-loop",
    description: "Show agent event loop",
    tasks: #{ main: #{} },
};

pub async fn main() {
    let a = call_agent("Say 'red'").model("small").await?;
    loop {
        let event = a.poll().await?;
        println!("{event:?}");
        match event {
            Event::Assistant(text) if text.to_lowercase().contains("red") => {
                a.send("Now say 'blue'").await?
            }
            Event::Assistant(_) => a.stop().await?,
            Event::Stop(_) => break,
            _ => {}
        }
    }
}

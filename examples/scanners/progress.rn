use gage::Progress;
use time::{Duration, sleep};

pub const SCANNER = #{
    name: "progress",
    description: "Show scan progress",
    tasks: #{ iter: #{}, set: #{} },
};

pub async fn iter() {
    for i in Progress::iter(0..12) {
        log::info!("iter item {i}");
        sleep(Duration::from_millis(1000)).await;
    }
    Ok(())
}

pub async fn set() {
    let total = 6;
    let p = Progress::new(total);
    let i = 0;
    while i <= total {
        log::info!("i {i}");
        i += 1;
        p.set(i);
        sleep(Duration::from_millis(1000)).await;
    }
    Ok(())
}

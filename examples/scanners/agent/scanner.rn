use gage::call_agent;

pub const SCANNER = #{
    name: "test-agent",
    hidden: true,
    description: "Test agent judge",
    tasks: #{ main: #{} },
};

pub async fn main() {
    let session = call_agent("/gage:judge", #{}).await?;
    let out = session.wait().await?;
    println!("### {out:?}");
}

use gage::call_agent;

pub const SCANNER = #{
    name: "test-agent",
    hidden: true,
    description: "Test agent",
    tasks: #{ agent: #{} },
};

pub async fn agent() {
    let session = call_agent("Write a comment with the text 'Hello Joe'")
        .allow_tools(["CommentWrite"])
        .model("medium")
        .await?;
    let out = session.wait().await?;
    println!("## agent # {out:?}");
}

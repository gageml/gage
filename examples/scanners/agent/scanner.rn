use gage::{call_agent, scan, write_note};

pub const SCANNER = #{
    name: "test-agent",
    hidden: true,
    description: "Test agent",
    tasks: #{ agent: #{} },
};

pub async fn agent() {
    let session = call_agent("Write a comment with the text 'Hello Joe'")
        .tools(
            #{
                comment: #{
                    name: "Comment",
                    description: "Write a comment",
                    inputs: #{
                        text: #{ type: "string", description: "Comment text" },
                    },
                },
            },
        )
        .model("medium")
        .await?;
    let out = session.wait().await?;
    println!("## agent # {out:?}");
}

pub async fn comment(#{ text }) {
    write_note(
        #{ name: "comment.test", value: text, target: #{ scan: scan().id } },
    )
    .replace_prev()
    .await?
}

use gage::{DateTime, scan, write_note};

pub const SCANNER = #{
    name: "note-deps",
    description: "Test note writing with deps",
    tasks: #{
        a: #{ notes: #{ writes: #{ "a": "Test note a" } } },
        b: #{ notes: #{ writes: #{ "b": "Test note b" }, wants: ["a"] } },
    },
};

pub async fn a() {
    let now = DateTime::now();
    for s in scan().sessions() {
        write_note(
            #{ name: "a", value: now.millis(), target: #{ session: s.id } },
        )
        .replace_prev()
        .await?;
    }
}

pub async fn b() {
    let notes = scan().notes().with_name("a").await?;
    write_note(
        #{ name: "b", value: notes.len(), target: #{ scan: scan().id } },
    )
    .replace_prev()
    .await?
}

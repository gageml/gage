use gage::{call_agent, scan, write_note};

pub const SCANNER = #{
    name: "scanner-tool",
    hidden: true,
    description: "Test use of scanner defined tool",
    tasks: #{ scanner_tool: #{} },
};

/// Writes a comment using a scanner tool.
pub async fn scanner_tool() {
    let agent = call_agent(
        "Write a comment 'Hello, Mike' with the Comment tool.",
    )
    .tools(
        #{
            comment: #{
                name: "Comment",
                description: "Write a comment.",
                inputs: #{
                    text: #{ type: "string", description: "Comment text" },
                },
            },
        },
    )
    .model("medium")
    .await?;
    let out = agent.wait().await?;
    println!("## scanner-tool # {out:?}");
}

pub async fn comment(#{ text }) {
    write_note(#{ name: "comment", value: text, target: #{ scan: scan().id } })
        .replace_prev()
        .await
}

use gage::{Input, Tool, call_agent, params};

pub const SCANNER = #{
    name: "agent-tool",
    description: "Scanner provided tool",
    tasks: #{ simple: #{}, inputs: #{} },
    params: #{ secret: "abc" },
};

pub async fn simple() {
    let secret = params().secret;
    let a = call_agent("What's the secret?")
        .model("small")
        .tool(Tool::new("secret", |_| Ok(secret)))
        .await?;
    let result = a.wait().await?;
    println!("{}", result.text);
}

pub async fn inputs() {
    let a = call_agent("Greet Joe with the Greet tool")
        .model("small")
        .tool(
            Tool::new("Greet", greet)
                .input(Input::string("name").required())
                .meta_arg(),
        )
        .await?;
    let result = a.wait().await?;
    println!("{}", result.text);
}

fn greet(inputs, meta) {
    Ok(format!("Hello, {} (call {})", inputs.name, meta.agent_tool_use()))
}

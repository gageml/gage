use gage::{Event, call_agent, params};

pub const SCANNER = #{
    name: "agent-loop",
    description: "Show agent event loop",
    tasks: #{ main: #{} },
    params: #{ prompt: "Say hello" },
};

pub async fn main() {
    let prompt = params().prompt;
    let a = call_agent(prompt).model("small").await?;
    loop {
        let event = a.poll().await?;
        println!("{event:?}");
        if let Event::Stop(_) = event {
            assert!(!a.running());
            break;
        }
    }
}

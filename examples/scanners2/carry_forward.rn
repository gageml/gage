use gage::{carry_forward_notes, scan, write_note};

pub const SCANNER = #{
    name: "carry-forward",
    description: "Carry forward example",
    tasks: #{ main: #{} },
};

const KEY = ("carry-forward-example", "main", 1);

pub async fn main() {
    carry_forward_notes(KEY).await?;
    let carried = scan().notes().name("native-size").await?;
    println!("Notes from previous scans: {carried:?}");
    for s in scan().sessions().await {
        let attrs = s.attrs().await;
        write_note("native-size", attrs.native_size)
            .for_session(s.id)
            .carry_forward_key(KEY)
            .await?;
    }
}

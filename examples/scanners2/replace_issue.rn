use gage::{scan, write_issue};

pub const SCANNER = #{
    name: "replace-issue",
    description: "Issues with an identity key",
    tasks: #{ main: #{} },
};

pub async fn main() {
    write_issue("named-example", "Example issue re-opened by name", "")
        .key("named-example")
        .await?;

    for s in scan().sessions().await {
        write_issue(
            "keyed-example",
            format!("Example issue re-opened by key for {}", s.id),
            "",
        )
        .key(("keyed", s.id))
        .await?;
    }
}

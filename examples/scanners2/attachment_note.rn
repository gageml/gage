use gage::{Mark, scan, watermark, write_note};

pub const SCANNER = #{
    name: "attachment-note",
    description: "Write attachment notes",
    tasks: #{ main: #{} },
};

const KEY = "attachment-note-test";

pub async fn main() {
    for a in scan().attachments().unseen(KEY).await? {
        write_note(
            "test-note",
            format!("Nothing to see for attachment {}", a.id),
        )
        .target(a)
        .await?;
        watermark(Mark::attachment(a), KEY).await?;
    }
}

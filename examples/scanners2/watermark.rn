use gage::{scan, watermark};

pub const SCANNER = #{
    name: "watermark",
    description: "Watermark sessions",
    tasks: #{ main: #{} },
};

const KEY = ("watermark", "findings", 1);

pub async fn main() {
    for (s, unseen) in scan().sessions().with_unseen(KEY).await? {
        if let Some((line, line_end)) = unseen {
            println!(
                "Session {} seen, lines {}-{} unseen",
                s.id,
                line,
                line_end
            )
        } else {
            println!("Session {} not seen", s.id);
        }
        watermark(s, KEY).await?;
    }
}

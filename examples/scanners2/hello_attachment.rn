use gage::{Files, attach, dataset, scan};

pub const SCANNER = #{
    name: "hello-attachment",
    description: "Attachment greeting",
    attachments: #{ readme: #{} },
    tasks: #{ main: #{ attachments: #{ wants: ["readme"] } } },
};

pub async fn main() {
    for a in scan().attachments().name("readme").await? {
        println!("{a:?}");
    }
}

pub async fn attach_readme() {
    for s in dataset().sessions().await {
        if let Some(project) = s.attrs().await.project {
            attach(Files::include(["README.md"]).root(project))
                .name("readme")
                .target(s)
                .await?;
        }
    }
}

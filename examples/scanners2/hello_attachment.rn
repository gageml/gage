use gage::{Files, attach, scan};

pub const SCANNER = #{
    name: "hello-attachment",
    description: "Attachment greeting",
    tasks: #{
        readme: #{ attaches: ["hello-attachment-src"] },
        main: #{ attachments: #{ wants: ["hello-attachment-src"] } },
    },
};

pub async fn readme() {
    attach(Files::include("hello_attachment.rn"))
        .name("hello-attachment-src")
        .await
}

pub async fn main() {
    for a in scan().attachments().name("hello-attachment-src").await? {
        println!("Hello {a:?}");
    }
}

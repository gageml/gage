use gage::{Files, attach, dataset, scan};

pub const SCANNER = #{
    name: "hello-attachment",
    description: "Attachment greeting",
    attachments: #{ readme: #{ f: attach_readme } },
    tasks: #{ main: #{ attachments: #{ wants: ["readme"] } } },
};

pub async fn main() {
    for a in scan().attachments().name("readme").await? {
        println!("{a:?}");
    }
}

pub async fn attach_readme() {
    for s in dataset().attachments().await {
        if let Some(p) = s.project {
            attach(
                Files::include(["README.md"]).root(p.path).name("readme").await?,
            )
            .target(s)
            .await?;
        }
    }
}

use gage::{call_agent, tools::Query};

pub const SCANNER = #{
    name: "gage-query-tool",
    description: "Query tool use",
    tasks: #{ main: #{} },
};

pub async fn main() {
    let a = call_agent("How many sessions are there?")
        .model("small")
        .tool(Query::new())
        .await?;
    let result = a.wait().await?;
    println!("{}", result.text);
}

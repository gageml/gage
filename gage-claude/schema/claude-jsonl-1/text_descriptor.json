{
  "safe": [
    "$.uuid",
    "$.parentUuid",
    "$.leafUuid",
    "$.sessionId",
    "$.session_id",
    "$.timestamp",
    "$.requestId",
    "$.requestRef",
    "$.serverClassifierRequest",
    "$.serverClassifierContext.request",
    "$.promptId",
    "$.sourceToolAssistantUUID",
    "$.sourceToolUseID",
    "$.refusedMessageId",
    "$.refusedUserMessageUuid",
    "$.interruptedMessageId",
    "$.imagePasteIds",
    "$.toolUseID",
    "$.commandUuid",
    "$.deliveryId",
    "$.messageId",
    "$.snapshotMessageId",
    "$.startTime",
    "$.id",
    "$.base",
    "$.tail",
    "$.hash",
    "$.shapeHash",
    "$.requestDigest",
    "$.message.id",
    "$.message.content[*].id",
    "$.message.content[*].tool_use_id",
    "$.message.content[*].signature",
    "$.attachment.toolUseID",
    "$.attachment.organizationUuid",
    "$.attachment.source_uuid",
    "$.attachment.delivery_id",
    "$.attachment.runId",
    "$.attachment.timestamp",
    "$.attachment.date",
    "$.attachment.toolInputCopies[*].id",
    "$.attachment.surfacedDefinitions[*].listing",
    "$.params.safeguards[*].classifier_context.prior_turn_context[*].tool_use_ids"
  ],
  "atomic": [
    "$.message.content[?@.type == 'tool_use']",
    "$.message.content[?@.type == 'tool_result']",
    "$.toolUseResult",
    "$.wireToolInputs"
  ],
  "filters": {
    "pii": {
      "literal": ["$..user_identity", "$..home_dir"],
      "value": ["$.attachment.context.userEmail"]
    }
  }
}

use gage::{Template, filter::{Literal, Reason, Value}, params, publish};

pub const FILTER = #{
    name: "pii",
    description: "Remove personally identifiable information",
    groups: ["public"],
    params: #{ prompt: #{ value: "", description: "Additional instructions" } },
    tasks: #{ pii: #{} },
};

const PATTERNS = #{
    email: "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
    phone: "(?:^|[^0-9A-Za-z])((?:\\+?[0-9]{1,3}[ .-])?\\(?[0-9]{3}\\)?[ .-][0-9]{3}[ .-][0-9]{4})(?:[^0-9A-Za-z]|$)",
    ssn: "(?:^|[^0-9-])([0-9]{3}-[0-9]{2}-[0-9]{4})(?:[^0-9-]|$)",
    git_user: "(?m)^Git user: (.+?)[ \t]*$",
};

pub async fn pii() {
    let t = Template::new(include_str!("redact-prompt.md.j2"))?;
    let redact_prompt = t.render(#{ prompt: params().prompt });
    publish()
        .remove_values(Value::pii(), Reason::Pii)
        .literal_redact(Literal::pii(), Reason::Pii)
        .pattern_redact(PATTERNS, Reason::Pii)
        .agent_redact(redact_prompt);
    // Also support `.pattern_redact_no_mark(patterns, reason)`
}

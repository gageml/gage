use gage::{Template, filter::{Literal, Reason, Value}, params, publish};

pub const FILTER = #{
    name: "system",
    description: "Removes paths, hosts, OS details and other system details",
    groups: ["public", "trusted"],
    params: #{ prompt: #{ value: "", description: "Additional instructions" } },
    tasks: #{ system: #{} },
};

pub async fn system() {
    let t = Template::new(include_str!("redact-prompt.md.j2"))?;
    let redact_prompt = t.render(#{ prompt: params().prompt });
    publish()
        .remove_values(Value::system(), Reason::System)
        .literal_redact(Literal::system(), Reason::System)
        .agent_redact(redact_prompt);
}

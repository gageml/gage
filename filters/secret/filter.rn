use gage::{Template, params, publish};

pub const FILTER = #{
    name: "secret",
    version: "2.0.0",
    description: "Remove passwords, API keys, and other secrets",
    groups: ["public", "trusted"],
    params: #{ prompt: #{ value: "", description: "Additional instructions" } },
    tasks: #{ secrets: #{} },
};

pub async fn secrets() {
    let t = Template::new(include_str!("redact-prompt.md.j2"))?;
    let redact_prompt = t.render(#{ prompt: params().prompt });
    publish().agent_redact(redact_prompt);
}

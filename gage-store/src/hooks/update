#!/bin/sh
# Gage store update hook. Enforces the ref rules of ref generation 1:
# the closed-artifact rule for refs/gage/1/object/*, and the naming
# rules for refs/gage/1/tag/* and refs/gage/1/key/*. Any other ref,
# including the refs of a later generation, passes: the rules below
# are this generation's conventions and may not hold for the next.
# Written verbatim by gage-store at init; edits are clobbered on the
# next `gage store init`. Uses shell builtins and git only, so the
# receiving host needs nothing beyond git itself.

refname="$1"
old="$2"
new="$3"

case "$refname" in
    refs/gage/1/object/*) kind=object ;;
    refs/gage/1/tag/*) kind=tag ;;
    refs/gage/1/key/*) kind=key ;;
    *) exit 0 ;;
esac

zero="0000000000000000000000000000000000000000"

# Ref creation.
if [ "$old" = "$zero" ]; then
    exit 0
fi

# Ref deletion.
if [ "$new" = "$zero" ]; then
    echo "gage: deletion of $refname is prohibited" >&2
    exit 1
fi

# Tag and key refs name an object through the `id` blob of the commit
# they point at. An advance to another commit of the same object is
# accepted in either direction, so a lagging ref on either side is not
# an error. A retarget to a different object is rejected, except that
# a key whose current target is a tombstone is free and may be claimed.
if [ "$kind" != object ]; then
    old_id=$(git rev-parse --verify -q "$old:id" 2>/dev/null)
    new_id=$(git rev-parse --verify -q "$new:id" 2>/dev/null)
    if [ -n "$old_id" ] && [ "$old_id" = "$new_id" ]; then
        exit 0
    fi
    if [ "$kind" = key ] && git cat-file -e "$old:deleted" 2>/dev/null; then
        exit 0
    fi
    echo "gage: $refname cannot be retargeted to a different object" >&2
    exit 1
fi

if git cat-file -e "$old:deleted" 2>/dev/null; then old_dead=1; else old_dead=0; fi
if git cat-file -e "$new:deleted" 2>/dev/null; then new_dead=1; else new_dead=0; fi

# Whether new names the same object as old: the type, id, and created
# entries are compared by blob SHA. A commit that supersedes another
# copies these entries from it.
same_identity() {
    for entry in type id created; do
        old_sha=$(git rev-parse --verify -q "$old:$entry" 2>/dev/null)
        new_sha=$(git rev-parse --verify -q "$new:$entry" 2>/dev/null)
        if [ -z "$old_sha" ] || [ "$old_sha" != "$new_sha" ]; then
            mismatch=$entry
            return 1
        fi
    done
    return 0
}

# Whether new is a share or a published session: the two types whose
# content a retraction replaces.
retractable() {
    case "$(git cat-file -p "$new:type" 2>/dev/null)" in
        "gage::share "*) return 0 ;;
        "gage::session "*)
            case "$(git cat-file -p "$new:attrs.json" 2>/dev/null)" in
                *'"publish"'*) return 0 ;;
            esac
            ;;
    esac
    return 1
}

# Live to live: a fast-forward edit, or a replacement. A replacement
# retracts content: a share or a published session written again under
# the same identity with no first-parent entry, so the ref stops
# reaching the commit it held.
if [ "$old_dead" = 0 ] && [ "$new_dead" = 0 ]; then
    if git merge-base --is-ancestor "$old" "$new" 2>/dev/null; then
        exit 0
    fi
    if ! git cat-file -e "$new:first-parent" 2>/dev/null \
        && retractable && same_identity; then
        exit 0
    fi
    echo "gage: non-fast-forward $refname is not a tombstone or a replacement" >&2
    exit 1
fi

# Tombstone onto tombstone: the object is closed.
if [ "$old_dead" = 1 ] && [ "$new_dead" = 1 ]; then
    echo "gage: $refname is closed by tombstone" >&2
    exit 1
fi

# The remaining shapes are the identity-preserving exception: live to
# tombstone (delete) and tombstone to live (resurrection of a derived-id
# object). Both must be parentless and name the same object as old.
if [ "$new_dead" = 1 ]; then shape=tombstone; else shape=resurrection; fi

if git rev-parse --verify -q "$new^1" >/dev/null 2>&1; then
    if [ "$old_dead" = 1 ]; then
        # A parented live commit onto a tombstone is an edit attempt
        echo "gage: $refname is closed by tombstone" >&2
    else
        echo "gage: tombstone $refname must be parentless" >&2
    fi
    exit 1
fi

if ! same_identity; then
    echo "gage: $shape $refname does not match object identity ($mismatch)" >&2
    exit 1
fi

exit 0

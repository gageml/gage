use gage::{
    AgentRunner,
    Input,
    Progress,
    Template,
    Tool,
    call_agent,
    carry_forward_notes,
    scan,
    watermark,
    tools::Query,
    write_note,
};

pub const SCANNER = #{
    name: "general-2",
    description: "Scan sessions for general findings",
    tasks: #{
        review: #{
            notes: #{
                writes: #{
                    "general[finding]": include_str!(
                        "finding-doc.md"
                    ),
                },
            },
        },
    },
};

const REVIEW_KEY = ("general", "review", 1);

pub async fn review() {
    let t = Template::new(include_str!("prompt.md.j2"))?;

    carry_forward_notes(REVIEW_KEY).await?;

    let sessions = unseen_sessions().await?;
    let progress = Progress::new(sessions.len());

    let runner = AgentRunner::new();

    // Add an agent for each non-skipped session
    for (s, start, end) in sessions {
        if let Some(reason) = skip_session(s).await? {
            log::info!("skip session {}: {}", s.id, reason);
            watermark(s, REVIEW_KEY).await?;
            progress.tick();
            continue;
        }

        let session_id = s.id;
        let prompt = t.render(#{ session_id })?;

        runner.add(
            call_agent(prompt)
                .name("general-finding")
                .tool(finding_tool())
                .tool(Query::with_session_range(s, start, end))
                .model("medium"),
            #{ session_id },
        );
    }

    // Collect agent results
    let results = runner.start();
    while let Some(next) = results.next().await {
        match next {
            Ok((result, #{ session_id })) => {
                log::info!(
                    "agent result: {:?}",
                    #{
                        session: session_id,
                        result: result.text,
                        metadata: result.as_metadata(),
                    },
                );
                watermark(session_id, REVIEW_KEY).await?;
            }
            Err(err) => {
                log::error!("agent error: {err:?}");
            }
        }
        progress.tick();
    }
}

async fn unseen_sessions() {
    Ok(
        scan()
            .sessions()
            .unseen(REVIEW_KEY)
            .await?
            .iter()
            .filter_map(
                |(s, unseen)| unseen.map(|(start, end)| (s, start, end)),
            )
            .collect::<Vec>(),
    )
}

const SESSION_MIN_TEXT_LEN = 200;

async fn skip_session(s) {
    let messages = s.messages().limit(50).await?;
    if messages.is_empty() {
        return Ok(Some("empty session"));
    }
    let text_len = 0;
    for m in messages {
        text_len += m.text.len();
        if text_len >= SESSION_MIN_TEXT_LEN {
            return Ok(None);
        }
    }
    Ok(Some(format!("text len {text_len} < min {SESSION_MIN_TEXT_LEN}")))
}

fn finding_tool() {
    Tool::new("Finding", write_finding)
        .input(Input::string("description").required())
        .input(Input::string("session_id").required())
        .input(
            Input::string("lines")
                .description(
                    "Session line numbers associated with the finding: \
                     a line (`112`), a range (`61-72`), or a \
                     comma-separated list (`28,31`)",
                ),
        )
}

pub async fn write_finding(inputs) {
    let lines = inputs.get("lines").unwrap_or("");
    let note = write_note("general[finding]", inputs.description)
        .for_session_lines(inputs.session_id, lines)
        .metadata(#{ lines })
        .work_key(REVIEW_KEY)
        .await?;
    Ok(format!("Wrote finding note {}", note.id))
}

use gage::{Progress, Template, call_agent, carry_forward_notes, scan, watermark, write_note};
// FUTURE: the agent runner and gage tools are not in the rethink
// runtime
use gage::AgentRunner;
use gage::tools::Query;

pub const SCANNER = #{
    name: "general-2",
    description: "Scan sessions for general findings",
    // FUTURE: groups: ["default"] when this scanner replaces `general`.
    // Left out so a legacy default scan does not select it.
    tasks: #{
        review: #{
            notes: #{
                writes: #{
                    "general[finding]": include_str!(
                        "finding-doc.md"
                    ),
                },
            },
        },
    },
};

const REVIEW_KEY = ("general", "review", 1);

pub async fn review() {
    let t = Template::new(include_str!("prompt.md.j2"))?;

    carry_forward_notes(REVIEW_KEY).await?;
    let sessions = unseen_sessions().await?;

    let progress = Progress::new(sessions.len());

    // FUTURE: AgentRunner
    let runner = AgentRunner::new();
    for (s, start, end) in sessions {
        if let Some(reason) = skip_session(s).await? {
            log::info!("Skipping session {}: {}", s.id, reason);
            watermark(s, REVIEW_KEY).await?;
            progress.tick();
            continue;
        }
        let prompt = t.render(#{ session_id: s.id })?;
        runner.add(
            // FUTURE: gage_tools and tools. The Query view is clipped
            // to the session's unseen lines
            call_agent(prompt)
                .name("general-finding")
                .gage_tools([Query::new().sessions([s]).lines(start, end)])
                .tools(#{ write_finding_tool: write_finding_tooldef() })
                .model("medium"),
            #{ session: s },
        );
    }
    collect_results(runner, progress).await
}

async fn unseen_sessions() {
    Ok(
        scan()
            .sessions()
            .unseen(REVIEW_KEY)
            .await?
            .iter()
            .filter_map(
                |(s, unseen)| unseen.map(|(start, end)| (s, start, end)),
            )
            .collect::<Vec>(),
    )
}

const SESSION_MIN_TEXT_LEN = 200;

async fn skip_session(s) {
    let messages = s.messages().limit(50).await?;
    if messages.is_empty() {
        return Ok(Some("empty session"));
    }
    let text_len = 0;
    for m in messages {
        text_len += m.text.len();
        if text_len >= SESSION_MIN_TEXT_LEN {
            return Ok(None);
        }
    }
    Ok(Some(format!("text len {text_len} < min {SESSION_MIN_TEXT_LEN}")))
}

fn write_finding_tooldef() {
    #{
        name: "Finding",
        description: "Write a finding about the session",
        inputs: #{
            description: #{
                type: "string",
                description: "Finding description",
            },
            session: #{ type: "string", description: "Session ID" },
            lines: #{
                type: "string",
                description: "Session line numbers associated with the finding: \
                              a line (`112`), a range (`61-72`), or a \
                              comma-separated list (`28,31`)",
                required: false,
            },
        },
    }
}

async fn collect_results(runner, progress) {
    // FUTURE: AgentRunner results
    let results = runner.start();
    while let Some(item) = results.next().await {
        let (result, #{ session }) = item?;
        log::info!(
            "findings: {:?}",
            #{
                session: session.id,
                result: result.text,
                metadata: result.as_metadata(),
            },
        );
        watermark(session, REVIEW_KEY).await?;
        progress.tick();
    }
}

// FUTURE: tool callbacks. The rethink runtime has no agent tool
// dispatch. When it does, a callback runs inside the task's scan
// context, and the note's author is the agent session that made the
// call (`session+task:<scan>/<scanner>:<task>/<native id>`), recorded
// by the runtime rather than passed by the scanner.

pub async fn write_finding_tool(inputs, meta) {
    let lines = inputs.get("lines").unwrap_or("");
    let note = write_note("general[finding]", inputs.description)
        .for_session_lines(inputs.session, lines)
        .metadata(#{ lines })
        .work_key(REVIEW_KEY)
        .await?;
    Ok(format!("Wrote finding note {}", note.id))
}

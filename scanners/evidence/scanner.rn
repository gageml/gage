use gage::{write_note, scan};

pub const SCANNER = #{
    name: "evidence",
    description: "General purpose evidence scanner",
    tasks: #{
        interrupt: #{
            notes: #{
                writes: #{
                    "msg.interrupt": #{
                        value: "'user' or 'tool_use' depending on the interrupt type",
                    },
                },
            },
        },
    },
};

const USER_MARKER = "[Request interrupted by user]";
const TOOL_USE_MARKER = "[Request interrupted by user for tool use]";

pub async fn interrupt() {
    for s in scan().sessions() {
        for (msg, kind) in s
            .messages()
            .with_type(#{ user: "text" })
            .await?
            .iter()
            .filter_map(
                |msg| if msg.text == USER_MARKER {
                    Some((msg, "user"))
                } else if msg.text == TOOL_USE_MARKER {
                    Some((msg, "tool_use"))
                } else {
                    None
                },
            )
        {
            write_note(
                #{
                    name: "msg.interrupt",
                    value: kind,
                    target: #{ session: s.id, line: msg.line },
                },
            )
            .keep_prev()
            .await?;
        }
    }
    Ok(())
}

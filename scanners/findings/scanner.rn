use gage::{
    Mark,
    Template,
    call_agent,
    carry_forward_notes_named,
    scan,
    tools::{IssueWrite, Query},
    watermark,
};

pub const SCANNER = #{
    name: "findings",
    description: "Issues across findings",
    groups: ["default"],
    tasks: #{
        review_findings: #{
            notes: #{ wants: ["*[finding]"] },
            issues: #{
                writes: #{ "findings": "Issue derived from finding notes" },
            },
        },
    },
};

const REPORT_KEY = ("findings", "report", 1);

pub async fn review_findings() {
    // Carry forward finding notes from previous scans
    let carried = carry_forward_notes_named("*[finding]").await?;
    log::info!("carried {carried} findings");

    // Get all finding notes for scan
    let findings = scan().notes().name("*[finding]").unseen(REPORT_KEY).await?;
    if findings.is_empty() {
        log::info!("no unreported findings for this scan");
        return Ok(());
    }

    // Construct agent prompt with findings
    let prompt = Template::new(include_str!("prompt.md.j2"))?
        .render(
            #{
                findings: findings
                    .iter()
                    .map(
                        |f| #{
                            id: f.id,
                            name: f.name,
                            target: f.target.unwrap_or_default(),
                        },
                    ),
            },
        )?;

    // Run agent with tools to query sessions and report issues
    let agent = call_agent(prompt)
        .name("issue-writer")
        .tools([Query::new(), IssueWrite::new().name("findings").pending()])
        .model("large")
        .await?;
    let result = agent.wait().await?;
    log::info!(
        "issues: {:?}",
        #{
            result: result.text,
            metadata: result.metadata(),
        },
    );

    // Note our work on this set of notes to skip next time
    for f in findings {
        watermark(Mark::note(f), REPORT_KEY).await?;
    }
}

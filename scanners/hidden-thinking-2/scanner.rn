// Model of the `hidden-thinking` scanner for the rethink runtime
// (`gage-scan2` and `gage-runtime2`). The scanner names the subject;
// the task names the action.
//
// Untagged code runs on the rethink runtime today. Code tagged
// `// FUTURE` needs a facility the rethink runtime does not have yet.
// Where the rethink design specifies the interface, FUTURE code is
// written against it; otherwise it follows the legacy interface as a
// placeholder. This file is a target, not a runnable scanner.

use gage::{scan, watermark, write_issue, write_note};

const KEY = ("hidden-thinking", "detect", 1);

pub const SCANNER = #{
    name: "hidden-thinking-2",
    // FUTURE: groups: ["default"] when this scanner replaces
    // `hidden-thinking`. Left out so a legacy default scan does not
    // select it.
    description: "
Detect sessions where model thinking is hidden

Thinking blocks provide important evidence of model thinking and
should be visible. Unfortunately, the default settings for Claude
Code cause thinking blocks to be hidden. This scanner looks for this
condition and recommends fixes for issues it finds.
",
    tasks: #{
        detect: #{
            notes: #{
                writes: #{
                    "empty-thinking": include_str!(
                        "thinking-empty-note.md"
                    ),
                },
            },
            // FUTURE: the user config attachment, for the
            // showThinkingSummaries setting
            attachments: #{ wants: ["config:"] },
        },
        report: #{
            notes: #{ wants: ["empty-thinking"] },
            issues: #{
                writes: #{ "hidden-thinking": "Thinking blocks are hidden" },
            },
        },
    },
};

/// Write a `empty-thinking` note on the latest thinking block across
/// the scan's sessions.
pub async fn detect() {
    // FUTURE: the user config comes from the dataset's `config:`
    // attachment (`scan().attachments("config")`); legacy read it
    // through `user().config()`, which the rethink removes
    let config = "TODO: showThinkingSummaries from the config attachment";

    // Look at the latest sessions first for empty thinking blocks.
    let latest = None;
    for (s, unseen) in scan().sessions().newest_first().with_unseen(KEY).await? {
        // Skip session messages we've seen
        let (start, end) = match unseen {
            Some(range) => range,
            None => continue,
        };

        // If current session is older than our working latest, we have
        // our latest
        if let Some((latest_msg, _)) = latest {
            let modified = s.attrs().await.modified;
            if modified <= latest_msg.timestamp {
                break;
            }
        }

        // Get the latest thinking msg for session - if it's older than
        // working latest we have latest, otherwise it becomes working latest
        for msg in s
            .messages()
            .lines(start, end)
            .type(#{ "assistant": "thinking" })
            .latest_first()
            .await?
        {
            let is_msg_older = match latest {
                Some((latest_msg, _)) => msg.timestamp > latest_msg.timestamp,
                None => false,
            };
            if is_msg_older {
                break;
            }
            latest = Some((msg, s.id));
        }
    }

    // If we have a latest thinking block, record its empty status
    if let Some((msg, session_id)) = latest {
        write_note("empty-thinking", msg.text == "")
            .for_session_line(session_id, msg.line)
            .metadata(
                #{ msg_timestamp: msg.timestamp, model: msg.model(), config },
            )
            .await?;
    }

    // Mark sessions as seen
    for s in scan().sessions().await {
        watermark(s, KEY).await?;
    }
}

/// Report an issue when the latest `empty-thinking` note says the
/// block was empty.
pub async fn report() {
    // Get empty-thinking notes written for this scan
    let notes = scan().notes().name("empty-thinking").await?;

    // Use the note for the latest msg --- this is our best evidence
    // of an issue
    if let Some(note) = latest_msg_note(notes) {
        if note.value {
            // `hidden-thinking` is a singleton. The notes are this
            // scan's, so each is new evidence: an existing issue, open
            // or closed, is reopened with it
            write_issue(
                "hidden-thinking",
                "Thinking blocks hidden in recent session",
                include_str!("issue-description.md"),
            )
            .evidence(note)
            .await?;
        }
    }
}

fn latest_msg_note(notes) {
    notes
        .iter()
        .reduce(
            |a, b| {
                let a_ts = a.metadata.get("msg_timestamp").unwrap();
                let b_ts = b.metadata.get("msg_timestamp").unwrap();
                if b_ts > a_ts {
                    b
                } else {
                    a
                }
            },
        )
}

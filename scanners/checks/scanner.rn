use gage::{
    AgentRunner,
    Files,
    Input,
    Mark,
    Progress,
    Target,
    Template,
    Tool,
    attach,
    call_agent,
    carry_forward_notes,
    dataset,
    params,
    scan,
    tools::Query,
    watermark,
    write_note,
};

pub const SCANNER = #{
    name: "checks",
    description: "Session checks made in one agent call per session",
    params: #{
        checks: #{
            value: ["general", "code-review"],
            description: "Checks to apply to each session",
        },
    },
    tasks: #{
        attach_project_files: #{
            attaches: ["project-rule-files", "project-stack-files"],
        },
        summarize_projects: #{
            attachments: #{
                wants: ["project-rule-files", "project-stack-files"],
            },
            notes: #{
                writes: #{
                    "rules[project-summary]": "Summary of project code rules",
                    "stack[project-summary]": "Summary of project stack and architecture",
                },
            },
        },
        scan_sessions: #{
            notes: #{
                wants: ["rules[project-summary]", "stack[project-summary]"],
                writes: #{
                    "general[finding]": include_str!(
                        "general-finding-note-doc.md"
                    ),
                    "code-review[finding]": include_str!(
                        "code-review-finding-note-doc.md"
                    ),
                },
            },
        },
    },
};

/// The checks, in the order they appear in a prompt. A check names
/// the finding note it writes, the condition a session must meet for
/// the check to apply, and the project summaries its instructions
/// include.
fn checks() {
    [
        #{
            name: "general",
            note: "general[finding]",
            when: "min-text",
            summaries: [],
            instructions: include_str!("general-check.md.j2"),
        },
        #{
            name: "code-review",
            note: "code-review[finding]",
            when: "file-writes",
            summaries: ["rules[project-summary]", "stack[project-summary]"],
            instructions: include_str!("code-review-check.md.j2"),
        },
    ]
}

/// The project summaries. A summary names the files it reads, the
/// attachment that holds them, the note it writes, and how to
/// summarize the files.
fn summaries() {
    [
        #{
            title: "Rules",
            note: "rules[project-summary]",
            attachment: "project-rule-files",
            files: [
                "CLAUDE.md",
                "CLAUDE.local.md",
                ".claude/settings.json",
                ".claude/settings.local.json",
                ".claude/rules/**/*.md",
                ".claude/skills/**/SKILL.md",
                ".claude/commands/**/*.md",
                ".claude/agents/**/*.md",
            ],
            instruction: "Summarize the project's rules in a way that is \
                useful for judging rule compliance in a session. Preserve \
                concrete requirements (naming, error handling, forbidden \
                patterns, workflow steps). Note any rules that are \
                inconsistent with each other or unclear --- this is your \
                judgement and is valuable to the downstream reader.",
        },
        #{
            title: "Stack",
            note: "stack[project-summary]",
            attachment: "project-stack-files",
            files: [
                "Cargo.toml",
                "package.json",
                "pyproject.toml",
                "go.mod",
                "Gemfile",
                "pom.xml",
                "build.gradle",
                "mix.exs",
                "deno.json",
                "composer.json",
                "requirements.txt",
                "justfile",
                "Makefile",
            ],
            instruction: "Describe the project's stack and architecture from \
                its manifest files. Evaluate the stack for standardness and \
                highlight bespoke or idiosyncratic features a reviewer \
                should know about.",
        },
    ]
}

pub async fn attach_project_files() {
    for (dir, sessions) in sessions_by_project().await {
        match attach_project(dir, sessions).await {
            Ok(()) => {}
            Err(e) => log::warn!("skip project {dir}: {e:?}"),
        }
    }
}

async fn attach_project(dir, sessions) {
    for s in summaries() {
        attach(Files::include(s.files).root(dir))
            .name(s.attachment)
            .targets(sessions)
            .await?;
    }
}

async fn sessions_by_project() {
    dataset()
        .sessions()
        .native()
        .await
        .iter()
        .filter_map(session_project_dir)
        .fold(#{}, acc_project_dir)
}

fn session_project_dir((s, native_result)) {
    match native_result {
        Ok(n) => n.project_dir.map(|dir| (s, dir)),
        Err(e) => {
            log::error!(
                "error reading native session for {}: {e:?}",
                s.id
            );
            None
        }
    }
}

fn acc_project_dir(acc, (s, project_dir)) {
    if let Some(sessions) = acc.get(project_dir) {
        sessions.push(s);
    } else {
        acc.insert(project_dir, [s]);
    }
    acc
}

const SUMMARIZE_PROJECTS_KEY = ("checks", "summarize-projects", 1);

pub async fn summarize_projects() {
    carry_forward_notes(SUMMARIZE_PROJECTS_KEY).await?;

    let attachments = scan()
        .attachments()
        .names(summaries().iter().map(|s| s.attachment).collect::<Vec>())
        .unseen(SUMMARIZE_PROJECTS_KEY)
        .await?;
    let project_dirs = attachment_roots(attachments);
    let progress = Progress::new(project_dirs.len());

    // Create an agent to summarize each project
    let t = Template::new(include_str!(
        "summarize-project-prompt.md.j2"
    ))?;
    let agents = AgentRunner::new();
    for (project_dir, attachments) in project_dirs {
        let sections = project_sections(attachments).await?;
        if sections.is_empty() {
            log::info!("project {}: no project files", project_dir);
            for a in attachments {
                watermark(Mark::attachment(a), SUMMARIZE_PROJECTS_KEY).await?;
            }
            progress.tick();
            continue;
        }
        let prompt = t.render(#{ project_dir, sections });
        agents.add(
            call_agent(prompt)
                .name("summarize-project")
                .tool(summary_tool())
                .model("medium"),
            #{ project_dir, attachments },
        );
    }

    // Run agents
    let results = agents.start();
    while let Some(next) = results.next().await {
        match next {
            Ok((result, #{ project_dir, attachments })) => {
                log::info!(
                    "project-summary: {:?}",
                    #{
                        project_dir,
                        result: result.text,
                        metadata: result.metadata(),
                    },
                );
                for a in attachments {
                    watermark(Mark::attachment(a), SUMMARIZE_PROJECTS_KEY)
                        .await?;
                }
            }
            Err(err) => {
                log::error!("agent error: {err:?}");
            }
        }
        progress.tick();
    }
}

fn attachment_roots(attachments) {
    attachments
        .iter()
        .fold(
            #{},
            |acc, a| {
                if let Some(l) = acc.get(a.root) {
                    l.push(a);
                } else {
                    acc.insert(a.root, [a]);
                }
                acc
            },
        )
}

/// One prompt section per attachment that holds files: the files
/// with the title, note name, and instruction of the summary the
/// attachment belongs to.
async fn project_sections(attachments) {
    let sections = [];
    for a in attachments {
        let name = a.name.unwrap();
        let summary = match summaries().iter().find(|s| s.attachment == name) {
            Some(summary) => summary,
            None => continue,
        };
        let files = [];
        for key in a.files().await {
            let f = a.file(key).await.unwrap();
            files.push(#{ path: key, text: f.text()? });
        }
        if !files.is_empty() {
            sections.push(
                #{
                    title: summary.title,
                    note: summary.note,
                    instruction: summary.instruction,
                    attachment_id: a.id,
                    files,
                },
            );
        }
    }
    Ok(sections)
}

fn summary_tool() {
    Tool::new("project_summary", write_summary)
        .description("Write a project summary note")
        .input(
            Input::string("name")
                .description("Note name as directed by the prompt")
                .required(),
        )
        .input(
            Input::string("attachment_id")
                .description("Attachment ID as directed by the prompt")
                .required(),
        )
        .input(
            Input::string("summary").description("Summary content").required(),
        )
}

pub async fn write_summary(inputs) {
    if !summaries().iter().any(|s| s.note == inputs.name) {
        return Ok(format!("error: unknown note name `{}`", inputs.name));
    }
    let note = write_note(inputs.name, inputs.summary)
        .target(Target::attachment(inputs.attachment_id))
        .carry_forward(SUMMARIZE_PROJECTS_KEY)
        .await?;
    Ok(format!("Wrote summary note {}", note.id))
}

/// Submit each session to one agent that applies every selected
/// check the session meets the condition of.
///
/// Every session is scanned in full on every run. A repeat run over
/// the same sessions is an independent pass, and its notes belong to
/// the scan that wrote them.
pub async fn scan_sessions() {
    let selected = select_checks(params().checks)?;
    let frame = Template::new(include_str!("scan-session-prompt.md.j2"))?;

    let sessions = scan().sessions().await;
    let progress = Progress::new(sessions.len());

    // Lookup table of summary notes per attachment
    let summary_notes = summary_notes_by_attachment().await?;

    // Create one agent for each session a check applies to
    let agents = AgentRunner::new();
    for s in sessions {
        let applied = [];
        for check in selected {
            if check_applies(check, s).await? {
                applied.push(check);
            }
        }
        if applied.is_empty() {
            log::info!("skip session {}: no check applies", s.id);
            progress.tick();
            continue;
        }
        let project_notes = session_summaries(s, summary_notes).await?;
        let prompt = render_prompt(frame, s.id, applied, project_notes)?;
        let check_names = applied.iter().map(|c| c.name).collect::<Vec>();
        agents.add(
            call_agent(prompt)
                .name("checks")
                .tool(finding_tool(check_names))
                .tool(Query::new().session(s))
                .model("medium"),
            #{ session_id: s.id, checks: check_names },
        );
    }

    // Run agents
    let results = agents.start();
    while let Some(next) = results.next().await {
        match next {
            Ok((result, #{ session_id, checks })) => {
                log::info!(
                    "agent result: {:?}",
                    #{
                        session: session_id,
                        checks,
                        result: result.text,
                        metadata: result.metadata(),
                    },
                );
            }
            Err(err) => {
                log::error!("agent error: {err:?}");
            }
        }
        progress.tick();
    }
}

/// The checks named in `names`, in definition order. An unknown name
/// or an empty selection is an error.
fn select_checks(names) {
    let all = checks();
    for name in names {
        if !all.iter().any(|c| c.name == name) {
            return Err(format!("unknown check `{name}`"));
        }
    }
    let selected = all
        .iter()
        .filter(|c| names.iter().any(|name| name == c.name))
        .collect::<Vec>();
    if selected.is_empty() {
        return Err("no checks selected");
    }
    Ok(selected)
}

async fn check_applies(check, s) {
    match check.when {
        "min-text" => has_min_text(s).await,
        "file-writes" => wrote_files(s).await,
        when => Err(format!("check `{}`: unknown condition `{when}`", check.name)),
    }
}

const SESSION_MIN_TEXT_LEN = 200;

async fn has_min_text(s) {
    let text_len = 0;
    for m in s.messages().limit(50).await {
        text_len += m.text.len();
        if text_len >= SESSION_MIN_TEXT_LEN {
            return Ok(true);
        }
    }
    Ok(false)
}

async fn wrote_files(s) {
    Ok(s.tool_uses().await.iter().any(wrote_a_file))
}

fn wrote_a_file(t) {
    t.files().iter().any(|f| f.type == "write")
}

/// The prompt for one session: the frame with each applied check's
/// instructions. A check's instructions include the project notes
/// the check names under `summaries`.
fn render_prompt(frame, session_id, applied, project_notes) {
    let sections = [];
    for check in applied {
        let summaries = project_notes
            .iter()
            .filter(|n| check.summaries.iter().any(|name| name == n.name))
            .collect::<Vec>();
        // `Template::new` takes its source, so each render compiles a
        // copy and leaves the check's instructions readable.
        let instructions = Template::new(`${check.instructions}`)?
            .render(#{ session_id, summaries });
        sections.push(#{ name: check.name, instructions: instructions.trim() });
    }
    Ok(frame.render(#{ session_id, checks: sections }))
}

async fn summary_notes_by_attachment() {
    Ok(
        scan()
            .notes()
            .names(summaries().iter().map(|s| s.note).collect::<Vec>())
            .await?
            .iter()
            .fold(
                #{},
                |acc, n| {
                    if let Some(attachment_id) = attachment_target(n) {
                        if let Some(l) = acc.get(attachment_id) {
                            l.push(n);
                        } else {
                            acc.insert(attachment_id, [n]);
                        }
                    }
                    acc
                },
            ),
    )
}

fn attachment_target(note) {
    match note.target?.split_once(":") {
        Some(("attachment", id)) => Some(id),
        _ => None,
    }
}

async fn session_summaries(session, summary_notes) {
    Ok(
        session
            .attachments()
            .names(summaries().iter().map(|s| s.attachment).collect::<Vec>())
            .await?
            .fold(
                [],
                |acc, a| {
                    if let Some(notes) = summary_notes.get(a.id) {
                        acc.extend(notes);
                    }
                    acc
                },
            ),
    )
}

fn finding_tool(check_names) {
    Tool::new("finding", write_finding)
        .description("Write a finding about the session for one check")
        .input(
            Input::string("check")
                .description(
                    format!(
                        "The check the finding belongs to: {}",
                        check_names.iter().collect::<Vec>().join(", "),
                    ),
                )
                .required(),
        )
        .input(
            Input::string("description")
                .description("Finding description")
                .required(),
        )
        .input(Input::string("session_id").required())
        .input(
            Input::string("lines")
                .description(
                    "Session line numbers associated with the finding: \
                     a line (`112`), a range (`61-72`), or a \
                     comma-separated list (`28,31`)",
                ),
        )
}

pub async fn write_finding(inputs) {
    let check = match checks().iter().find(|c| c.name == inputs.check) {
        Some(check) => check,
        None => return Ok(format!("error: unknown check `{}`", inputs.check)),
    };
    let lines = inputs.get("lines").unwrap_or("");
    let note = write_note(check.note, inputs.description)
        .target(Target::session_lines(inputs.session_id, lines))
        .metadata(#{ lines })
        .await?;
    Ok(format!("Wrote {} finding note {}", check.name, note.id))
}

#[test]
fn select_checks_keeps_definition_order() {
    let names = select_checks(["code-review", "general"])
        .unwrap()
        .iter()
        .map(|c| c.name)
        .collect::<Vec>();
    assert_eq!(names, ["general", "code-review"]);
}

#[test]
fn select_checks_selects_one_check() {
    let selected = select_checks(["code-review"]).unwrap();
    assert_eq!(selected.len(), 1);
    assert_eq!(selected[0].note, "code-review[finding]");
}

#[test]
fn select_checks_rejects_an_unknown_name() {
    assert_eq!(
        select_checks(["general", "nope"]),
        Err("unknown check `nope`"),
    );
}

#[test]
fn select_checks_rejects_an_empty_selection() {
    assert_eq!(select_checks([]), Err("no checks selected"));
}

#[test]
fn render_prompt_holds_each_applied_check_once() {
    let frame = Template::new(include_str!("scan-session-prompt.md.j2"))
        .unwrap();
    let selected = select_checks(["general", "code-review"]).unwrap();
    let prompt = render_prompt(frame, "s1", selected, []).unwrap();
    assert!(prompt.contains("### Check `general`"));
    assert!(prompt.contains("### Check `code-review`"));
    assert!(prompt.contains("`general`, `code-review`."));
    assert!(prompt.contains("session_id = 's1'"));
    assert!(!prompt.contains("Project context"));

    // A second session renders from the same checks
    let again = render_prompt(frame, "s2", selected, []).unwrap();
    assert!(again.contains("session_id = 's2'"));

    let one = select_checks(["general"]).unwrap();
    let prompt = render_prompt(frame, "s1", one, []).unwrap();
    assert!(prompt.contains("### Check `general`"));
    assert!(!prompt.contains("### Check `code-review`"));
}

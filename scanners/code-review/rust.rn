use gage::{AgentRunner, Progress, Template, tools::Query, call_agent, query, scan, write_issue};

pub const SCANNER = #{
    name: "rust-code-review",
    description: "Review Rust code quality",
    tasks: #{ issues: #{} },
};

const REVIEW_KEY = ("rust-code-review", "issues", 1);

pub async fn issues() {
    let t = Template::new(include_str!("rust-prompt.md.j2")).await?;
    let runner = AgentRunner::new();
    let (_, sessions, validate) = scan()
        .sessions()
        .split_valid(REVIEW_KEY)
        .await?;
    let queued = 0;
    for s in sessions {
        // Skip sessions where the assistant wrote no Rust code
        if let Some(reason) = skip_session(s).await? {
            log::info!("Skipping session {}: {}", s.id, reason);
            validate(s).await?;
            continue
        }
        let prompt = t.render(#{ session_id: s.id }).await?;
        runner.add(
            call_agent(prompt)
                .gage_tools([Query::new()])
                .tools(#{ issue: issue_tooldef() }),
            #{ session: s.id },
        );
        queued += 1;
    }
    let p = Progress::new(queued);
    let results = runner.start();
    loop {
        match results.next().await {
            Some(Ok((result, #{ session }))) => {
                log::info!("{result:?}");
                validate(session).await?;
                p.tick();
            }
            None => break,
        }
    }
    Ok(())
}

async fn skip_session(s) {
    // Use query instead of iterating over messages to keep scanner
    // memory use down. Rust code written by the assistant shows up as
    // Edit/Write tool calls with a .rs file_path.
    let result = query(
        format!(
            "SELECT count(*) AS n FROM message \
            WHERE session_id = '{}' \
            AND type = 'assistant' AND subtype = 'tool_use' \
            AND regexp_like(raw, '\"file_path\"\\s*:\\s*\"[^\"]*\\.rs\"') \
            AND regexp_like(raw, '\"name\"\\s*:\\s*\"(Edit|Write|MultiEdit)\"')",
            s.id
        ),
    )
    .await?;
    let #{ n } = result.get(0).expect("should return one row");
    if n == 0 {
        Ok(Some("no Rust code written"))
    } else {
        Ok(None)
    }
}

fn issue_tooldef() {
    #{
        name: "Issue",
        description: "Write an issue",
        inputs: #{
            title: #{ type: "string", description: "Issue title" },
            description: #{ type: "string", description: "Issue description" },
            session: #{ type: "string", description: "Session ID" },
        },
    }
}

pub async fn issue(#{ title, description, session }, meta) {
    let issue = write_issue(
        #{
            name: "code-review",
            author: meta.agent_tool_use(),
            title,
            description,
            sessions: [session],
        },
    )
    .await?;
    Ok(format!("Wrote issue {}", issue.id))
}

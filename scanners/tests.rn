#[test]
fn test_random_f64() {
    let x = rand::rng().random::<f64>();
    assert!(x >= 0.0 && x < 1.0, "{}", x);
}

#[test]
fn test_vec_map() {
    let v = [1, 2, 3];
    // As with Rust, vectors don't support `.map()` directly
    let v2 = v.iter().map(|x| x + 1).collect::<Vec>();
    assert_eq!(v2, [2, 3, 4]);
}

#[test]
fn test_vec_join() {
    let v = ["a", "b", "c"];
    let joined = v.join(", ");
    assert_eq!(joined, "a, b, c");
}

#[test]
fn test_stats_mean() {
    assert_eq!(stats::mean([1, 2, 3]), Some(2.0));
    assert_eq!(stats::mean([1, 2.5, 4]), Some(2.5));
    assert_eq!(stats::mean([]), None);
    assert_eq!(stats::mean(#{ a: 2, b: 4 }.values()), Some(3.0));
}

#[test]
fn test_vec_combine() {
    // extend in place
    let a = [1];
    let b = [2];
    a.extend(b);
    assert_eq!(a, [1, 2]);

    // extend new
    let a = [1];
    let b = [2];
    let c = [];
    c.extend(a);
    c.extend(b);
    assert_eq!(c, [1, 2]);

    // chain
    let a = [1];
    let b = [2];
    let c = a.iter().chain(b).collect::<Vec>();
    assert_eq!(c, [1, 2]);
}

#[test]
fn test_progress_counter() {
    use gage::Progress;

    let p = Progress::new(3);
    p.tick();
    p.inc(2);
    p.set(1);
    p.reset(10);
}

#[test]
fn test_progress_iter() {
    let total = 0;
    for n in gage::Progress::iter([1, 2, 3].iter()) {
        total += n;
    }
    assert_eq!(total, 6);
}

#[test]
async fn test_template() {
    use gage::Template;

    // Simple template with no params
    let t = Template::new("xyz").await.unwrap();
    assert_eq!(t.render(#{}).await.unwrap(), "xyz");
    assert_eq!(t.render(#{foo: 123}).await.unwrap(), "xyz");

    // Single variable substitution
    let t = Template::new("Hello, {{ name }}").await.unwrap();
    assert_eq!(
        t.render(#{ name: "Joe" }).await.unwrap(),
        "Hello, Joe"
    );
    assert_eq!(
        t.render(#{ name: "Mike" }).await.unwrap(),
        "Hello, Mike"
    );

    // Missing variable renders empty
    let t = Template::new("x={{ x }}").await.unwrap();
    assert_eq!(t.render(#{}).await.unwrap(), "x=");

    // Fallback
    let t = Template::new("{{ foo or bar }}").await.unwrap();
    assert_eq!(t.render(#{}).await.unwrap(), "");
    assert_eq!(
        t.render(#{foo: "foo", bar: "bar"}).await.unwrap(),
        "foo"
    );
    assert_eq!(t.render(#{bar: "bar"}).await.unwrap(), "bar");

    // Conditional
    let t = Template::new("{% if a > 0 %}a{% else %}b{% endif %}")
        .await
        .unwrap();
    assert_eq!(t.render(#{}).await.unwrap(), "b");
    assert_eq!(t.render(#{a: 0}).await.unwrap(), "b");
    assert_eq!(t.render(#{a: 1}).await.unwrap(), "a");
}

#[test]
async fn test_template_parse_error() {
    match gage::Template::new("{% if %}").await {
        Err(gage::Error::Template(_)) => (),
        other => panic!("expected Template error, got {:?}", other),
    }
}

#[test]
async fn test_split_valid_empty() {
    // Test run selection is empty: both partitions are empty and
    // validate rejects a session it did not split as new.
    let (prev, new, validate) = gage::scan()
        .sessions()
        .split_valid(("test-scanner", "task", 1))
        .await
        .unwrap();
    assert_eq!(prev.len(), 0);
    assert_eq!(new.len(), 0);
    match validate("11111111-1111-1111-1111-111111111111").await {
        Err(gage::Error::Args(_)) => (),
        other => panic!("expected Args error, got {:?}", other),
    }
}

#[test]
async fn test_split_valid_key_must_be_composite() {
    match gage::scan().sessions().split_valid("flat-string").await {
        Err(gage::Error::Args(_)) => (),
        other => panic!("expected Args error, got {:?}", other),
    }
}

#[test]
async fn test_split_valid_range_empty() {
    // Same contract as split_valid: empty selection yields empty
    // partitions and validate rejects an unsplit session
    let (prev, new, validate) = gage::scan()
        .sessions()
        .split_valid_range(("test-scanner", "task", 1))
        .await
        .unwrap();
    assert_eq!(prev.len(), 0);
    assert_eq!(new.len(), 0);
    match validate("11111111-1111-1111-1111-111111111111").await {
        Err(gage::Error::Args(_)) => (),
        other => panic!("expected Args error, got {:?}", other),
    }
}

#[test]
async fn test_split_valid_range_key_must_be_composite() {
    match gage::scan().sessions().split_valid_range("flat-string").await {
        Err(gage::Error::Args(_)) => (),
        other => panic!("expected Args error, got {:?}", other),
    }
}

#[test]
async fn test_carry_forward_notes() {
    let session = "22222222-2222-2222-2222-222222222222";
    gage::write_note(
        #{
            name: "test.carry.finding",
            value: "a finding",
            target: #{ session: session },
        },
    )
    .await
    .unwrap();

    // A matching name links the note; an unknown name links nothing
    let n = gage::carry_forward_notes([session], ["test.carry.finding"])
        .await
        .unwrap();
    assert_eq!(n, 1);
    let n = gage::carry_forward_notes([session], ["test.carry.other"])
        .await
        .unwrap();
    assert_eq!(n, 0);
}

#[test]
async fn test_notes_split_valid() {
    let session = "44444444-4444-4444-4444-444444444444";
    gage::write_note(
        #{
            name: "test.split.finding",
            value: "a finding",
            target: #{ session: session },
        },
    )
    .await
    .unwrap();

    // First pass: the finding has never been recorded
    let (prev, new, validate) = gage::scan()
        .notes()
        .names(["test.split.finding"])
        .split_valid(("test-scanner", "issues", 1))
        .await
        .unwrap();
    assert_eq!(prev.len(), 0);
    assert_eq!(new.len(), 1);

    validate().await.unwrap();

    // Second pass: the finding is now recorded
    let (prev, new, _validate) = gage::scan()
        .notes()
        .names(["test.split.finding"])
        .split_valid(("test-scanner", "issues", 1))
        .await
        .unwrap();
    assert_eq!(prev.len(), 1);
    assert_eq!(new.len(), 0);
}

#[test]
async fn test_files_valid_does_not_consume_files() {
    // `files_valid` must only read its `files` argument; the caller
    // iterates the same list afterward to build the agent prompt.
    let files = [];
    let (valid, validate) = gage::files_valid(
        ("test-scanner", "task", "kind", 1),
        "/no/such/project",
        files,
    )
    .await
    .unwrap();
    assert_eq!(files.len(), 0);

    // The digest round-trips through validate: unrecorded, then valid
    assert_eq!(valid, false);
    validate().await.unwrap();
    let (valid, _validate) = gage::files_valid(
        ("test-scanner", "task", "kind", 1),
        "/no/such/project",
        files,
    )
    .await
    .unwrap();
    assert_eq!(valid, true);
}

#[test]
async fn test_carry_forward_does_not_consume_args() {
    // `carry_forward_notes` must only read its `sessions` and `names`
    // arguments; callers may reuse both lists after the call.
    let sessions = ["55555555-5555-5555-5555-555555555555"];
    let names = ["test.carry.keep"];
    let n = gage::carry_forward_notes(sessions, names).await.unwrap();
    assert_eq!(n, 0);
    assert_eq!(sessions.len(), 1);
    assert_eq!(names.len(), 1);
}

#[test]
async fn test_pending_issue_lifecycle() {
    gage::write_issue(
        #{ name: "test.pending", title: "A staged issue", pending: true },
    )
    .await
    .unwrap();

    let pending = gage::global()
        .issues()
        .status("pending")
        .name("test.pending")
        .await
        .unwrap();
    assert_eq!(pending.len(), 1);
    let issue = pending.get(0).unwrap();
    assert_eq!(issue.status, "pending");

    // Not visible as open until promoted
    let open = gage::global().issues().name("test.pending").await.unwrap();
    assert_eq!(open.len(), 0);

    gage::update_issue(issue.id, #{ status: "open", message: "novel" })
        .await
        .unwrap();
    let open = gage::global().issues().name("test.pending").await.unwrap();
    assert_eq!(open.len(), 1);

    gage::update_issue(
        issue.id,
        #{ status: "closed", status_reason: "duplicate", message: "dup of x" },
    )
    .await
    .unwrap();
    let closed = gage::global()
        .issues()
        .status("closed")
        .name("test.pending")
        .await
        .unwrap();
    assert_eq!(closed.len(), 1);
    assert_eq!(
        closed.get(0).unwrap().status_reason,
        Some("duplicate")
    );

    gage::update_issue(issue.id, #{ status: "open" }).await.unwrap();
    let open = gage::global().issues().name("test.pending").await.unwrap();
    assert_eq!(open.len(), 1);

    // Invalid status and missing status are errors
    assert!(
        gage::update_issue(issue.id, #{ status: "bogus" }).await.is_err()
    );
    assert!(gage::update_issue(issue.id, #{}).await.is_err());
}

#[test]
async fn test_note_issue_debug_fmt() {
    let note = gage::write_note(
        #{
            name: "test.debug",
            value: "v",
            target: #{ scan: gage::scan().id },
        },
    )
    .await
    .unwrap();
    let s = format!("{:?}", note);
    assert!(s.contains("Note {"));
    assert!(s.contains("name: \"test.debug\""));

    gage::write_issue(#{ name: "test.debug-issue", title: "T", pending: true })
        .await
        .unwrap();
    let issue = gage::global()
        .issues()
        .status("pending")
        .name("test.debug-issue")
        .await
        .unwrap()
        .get(0)
        .unwrap();
    let s = format!("{:?}", issue);
    assert!(s.contains("Issue {"));
    assert!(s.contains("status: \"pending\""));
}

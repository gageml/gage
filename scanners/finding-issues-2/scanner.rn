use gage::{Mark, call_agent, scan, watermark};
use gage::tools::{IssueWrite, Query};

pub const SCANNER = #{
    name: "finding-issues-2",
    description: "Report issues from session findings",
    library: true,
    tasks: #{
        report: #{
            notes: #{
                // `required_by` pulls this task into any scan whose
                // selected tasks write a matching note
                wants: ["*[finding]"],
            },
            // required_by: ["*[finding]"],
            issues: #{
                writes: #{ "findings": "Issue derived from session findings" },
            },
        },
    },
};

const REPORT_KEY = ("finding-issues", "report", 1);

pub async fn report() {
    let findings = scan().notes().name("*[finding]").unseen(REPORT_KEY).await?;
    if findings.is_empty() {
        log::info!("no unseen findings for this scan");
        return Ok(());
    }

    let agent = call_agent(include_str!("prompt.md"))
        .name("issue-writer")
        .tools([Query::new(), IssueWriter::new().name("findings")])
        .model("large")
        .await?;
    let result = agent.wait().await?;
    log::info!(
        "issues: {:?}",
        #{
            result: result.text,
            metadata: result.as_metadata(),
        },
    );
    for n in findings {
        watermark(Mark::note(n), REPORT_KEY).await?;
    }
    Ok(())
}

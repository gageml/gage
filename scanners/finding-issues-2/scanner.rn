use gage::tools::{IssueWrite, Query};
use gage::{Mark, Template, call_agent, carry_forward_notes_named, scan, watermark};

pub const SCANNER = #{
    name: "finding-issues-2",
    description: "Report issues from session findings",
    tasks: #{
        report: #{
            notes: #{
                // Ordering only: the report runs after any finding
                // writer in the same scan
                wants: ["*[finding]"],
            },
            issues: #{
                writes: #{ "findings": "Issue derived from session findings" },
            },
        },
    },
};

const REPORT_KEY = ("finding-issues", "report", 1);

/// Report issues from the findings written for the scan's sessions.
///
/// The findings already written for the sessions are carried into the
/// scan by name, so the task works with or without the finding
/// writers in the same scan. Only the findings no scan has reported
/// under the key reach the agent; each is watermarked once the agent
/// returns.
pub async fn report() {
    let carried = carry_forward_notes_named("*[finding]").await?;
    log::info!("carried {carried} findings");

    let findings = scan().notes().name("*[finding]").unseen(REPORT_KEY).await?;
    if findings.is_empty() {
        log::info!("no unreported findings for this scan");
        return Ok(());
    }

    // The agent reads every finding in the scan through Query; the
    // prompt names the ones no scan has reported yet
    let listed = [];
    for n in findings {
        let target = match n.target {
            Some(t) => t,
            None => "",
        };
        listed.push(#{ id: n.id, name: n.name, target });
    }
    let prompt = Template::new(include_str!("prompt.md.j2"))?.render(#{ findings: listed })?;

    let agent = call_agent(prompt)
        .name("issue-writer")
        .tools([Query::new(), IssueWrite::new().name("findings").pending()])
        .model("large")
        .await?;
    let result = agent.wait().await?;
    log::info!(
        "issues: {:?}",
        #{
            result: result.text,
            metadata: result.as_metadata(),
        },
    );
    for n in findings {
        watermark(Mark::note(n), REPORT_KEY).await?;
    }
    Ok(())
}

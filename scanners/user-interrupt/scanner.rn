use gage::{call_agent, scan, write_note};

pub const SCANNER = #{
    name: "user-interrupt",
    description: "Highlight user interrupts and evaluate",
    tasks: #{
        note: #{
            notes: #{
                writes: #{
                    "msg.interrupt": include_str!(
                        "interrupt-note.md"
                    ),
                },
            },
        },
        judge: #{ notes: #{ wants: ["msg.interrupt"] } },
    },
};

pub async fn note() {
    for s in scan().sessions() {
        for msg in s.messages().of_type(#{ "user": "text" }).await? {
            if let Some(value) = interrupt(msg) {
                write_note(
                    #{
                        name: "msg.interrupt",
                        value,
                        target: #{ session: s.id, line: msg.line },
                    },
                )
                .replace_prev()
                .await?;
            }
        }
    }
    Ok(())
}

fn interrupt(msg) {
    if msg.text == "[Request interrupted by user]" {
        Some("user")
    } else if msg.text == "[Request interrupted by user for tool use]" {
        Some("tool_use")
    } else {
        None
    }
}

const JUDGE_PROMPT = include_str!("judge.md");

pub async fn judge() {
    let agent = call_agent(JUDGE_PROMPT).allow_tools(["IssueOpen"]).await?;
    agent.wait().await?;
}

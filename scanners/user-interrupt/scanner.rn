use gage::{scan, write_note};

pub const SCANNER = #{
    name: "user-interrupt",
    description: "Highlight user interrupts",
    tasks: #{
        note: #{
            notes: #{
                writes: #{
                    "msg.interrupt": include_str!(
                        "msg.interrupt.md"
                    ),
                },
            },
        },
    },
};

pub async fn note() {
    for s in scan().sessions() {
        for msg in s.messages().with_type(#{ "user": "text" }).await? {
            if let Some(value) = if msg.text == "[Request interrupted by user]" {
                Some("user")
            } else if msg.text == "[Request interrupted by user for tool use]" {
                Some("tool_use")
            } else {
                None
            }
            {
                write_note(
                    #{
                        name: "msg.interrupt",
                        value,
                        target: #{ session: s.id, line: msg.line },
                    },
                )
                .replace_prev()
                .await?;

            }
        }
    }
    Ok(())
}

use gage::{
    AgentRunner,
    Files,
    Input,
    Mark,
    Progress,
    Target,
    Template,
    Tool,
    attach,
    call_agent,
    carry_forward_notes,
    dataset,
    scan,
    tools::Query,
    watermark,
    write_note,
};

pub const SCANNER = #{
    name: "code-review-2",
    description: "Code quality and project rule violations",
    groups: ["default"],
    tasks: #{
        attach_project_files: #{
            attaches: ["project-rule-files", "project-stack-files"],
        },
        summarize_projects: #{
            attachments: #{
                wants: ["project-rule-files", "project-stack-files"],
            },
            notes: #{
                writes: #{
                    "rules[project-summary]": "Summary of project code rules",
                    "stack[project-summary]": "Summary of project stack and architecture",
                },
            },
        },
        scan_sessions: #{
            notes: #{
                wants: ["rules[project-summary]", "stack[project-summary]"],
                writes: #{
                    "code-review[finding]": include_str!(
                        "finding-note-doc.md"
                    ),
                },
            },
        },
    },
};

const RULE_FILES = [
    "CLAUDE.md",
    "CLAUDE.local.md",
    ".claude/settings.json",
    ".claude/settings.local.json",
    ".claude/rules/**/*.md",
    ".claude/skills/**/SKILL.md",
    ".claude/commands/**/*.md",
    ".claude/agents/**/*.md",
];

const STACK_FILES = [
    "Cargo.toml",
    "package.json",
    "pyproject.toml",
    "go.mod",
    "Gemfile",
    "pom.xml",
    "build.gradle",
    "mix.exs",
    "deno.json",
    "composer.json",
    "requirements.txt",
    "justfile",
    "Makefile",
];

pub async fn attach_project_files() {
    for (dir, sessions) in sessions_by_project().await {
        attach(Files::include(RULE_FILES).root(dir))
            .name("project-rule-files")
            .targets(sessions)
            .await?;
        attach(Files::include(STACK_FILES).root(dir))
            .name("project-stack-files")
            .targets(sessions)
            .await?;
    }
}

async fn sessions_by_project() {
    dataset()
        .sessions()
        .native()
        .await
        .iter()
        .filter_map(session_project_dir)
        .fold(#{}, acc_project_dir)
}

fn session_project_dir((s, native_result)) {
    match native_result {
        Ok(n) => n.project_dir.map(|dir| (s, dir)),
        Err(e) => {
            log::error!(
                "error reading native session for {}: {e:?}",
                s.id
            );
            None
        }
    }
}

fn acc_project_dir(acc, (s, project_dir)) {
    if let Some(sessions) = acc.get(project_dir) {
        sessions.push(s);
    } else {
        acc.insert(project_dir, [s]);
    }
    acc
}

const SUMMARIZE_PROJECTS_KEY = ("code-review", "summarize-projects", 1);
const PROJECT_ATTACHMENTS = ["project-rule-files", "project-stack-files"];

pub async fn summarize_projects() {
    carry_forward_notes(SUMMARIZE_PROJECTS_KEY).await?;

    let attachments = scan()
        .attachments()
        .names(PROJECT_ATTACHMENTS)
        .unseen(SUMMARIZE_PROJECTS_KEY)
        .await?;
    let project_dirs = attachment_roots(attachments);
    let progress = Progress::new(project_dirs.len());

    // Create an agent to summarize each project
    let t = Template::new(include_str!(
        "summarize-project-prompt.md.j2"
    ))?;
    let agents = AgentRunner::new();
    for (project_dir, attachments) in project_dirs {
        let sections = project_sections(attachments).await?;
        if sections.is_empty() {
            log::info!("project {}: no project files", project_dir);
            for a in attachments {
                watermark(Mark::attachment(a), SUMMARIZE_PROJECTS_KEY).await?;
            }
            progress.tick();
            continue;
        }
        let prompt = t.render(#{ project_dir, sections })?;
        agents.add(
            call_agent(prompt)
                .name("summarize-project")
                .tool(summary_tool())
                .model("medium"),
            #{ project_dir, attachments },
        );
    }

    // Run agents
    let results = agents.start();
    while let Some(next) = results.next().await {
        match next {
            Ok((result, #{ project_dir, attachments })) => {
                log::info!(
                    "project-summary: {:?}",
                    #{
                        project_dir,
                        result: result.text,
                        metadata: result.metadata(),
                    },
                );
                for a in attachments {
                    watermark(Mark::attachment(a), SUMMARIZE_PROJECTS_KEY)
                        .await?;
                }
            }
            Err(err) => {
                log::error!("agent error: {err:?}");
            }
        }
        progress.tick();
    }
}

fn attachment_roots(attachments) {
    attachments
        .iter()
        .fold(
            #{},
            |acc, a| {
                if let Some(l) = acc.get(a.root) {
                    l.push(a);
                } else {
                    acc.insert(a.root, [a]);
                }
                acc
            },
        )
}

async fn project_sections(attachments) {
    let sections = [];
    for a in attachments {
        let files = [];
        for key in a.files().await {
            let f = a.file(key).await.unwrap();
            files.push(#{ path: key, text: f.text()? });
        }
        if !files.is_empty() {
            sections.push(
                #{ attachment: a.name.unwrap(), attachment_id: a.id, files },
            );
        }
    }
    Ok(sections)
}

fn summary_tool() {
    Tool::new("ProjectSummary", write_summary)
        .description("Write a project summary note")
        .input(
            Input::string("name")
                .description("Note name as directed by the prompt")
                .required(),
        )
        .input(
            Input::string("attachment_id")
                .description("Attachment ID as directed by the prompt")
                .required(),
        )
        .input(
            Input::string("summary").description("Summary content").required(),
        )
}

const SUMMARY_NOTES = ["rules[project-summary]", "stack[project-summary]"];

pub async fn write_summary(inputs) {
    if !SUMMARY_NOTES.iter().any(|n| n == inputs.name) {
        return Ok(format!("error: unknown note name `{}`", inputs.name));
    }
    let note = write_note(inputs.name, inputs.summary)
        .target(Target::attachment(inputs.attachment_id))
        .carry_forward_key(SUMMARIZE_PROJECTS_KEY)
        .await?;
    Ok(format!("Wrote summary note {}", note.id))
}

const SCAN_SESSIONS_KEY = ("code-review", "scan-sessions", 1);

pub async fn scan_sessions() {
    carry_forward_notes(SCAN_SESSIONS_KEY).await?;

    let sessions = scan().sessions().unseen(SCAN_SESSIONS_KEY).await?;
    let progress = Progress::new(sessions.len());

    // Lookup table of summary notes per attachment
    let summary_notes = summary_notes_by_attachment().await?;

    // Create an agent to scan each unskipped session
    let t = Template::new(include_str!("scan-session-prompt.md.j2"))?;
    let agents = AgentRunner::new();
    for (s, range) in sessions {
        if let Some(reason) = skip_session(s).await? {
            log::info!("skip session {}: {}", s.id, reason);
            watermark(Mark::session(s), SCAN_SESSIONS_KEY).await?;
            progress.tick();
            continue;
        }
        let summaries = session_summaries(s, summary_notes).await?;
        let prompt = t.render(#{ session_id: s.id, summaries })?;
        agents.add(
            call_agent(prompt)
                .name("code-review")
                .tool(finding_tool())
                .tool(Query::with_session_range(s, range))
                .model("medium"),
            #{ session: s },
        );
    }

    // Run agents
    let results = agents.start();
    while let Some(next) = results.next().await {
        match next {
            Ok((result, #{ session })) => {
                log::info!(
                    "code-review findings: {:?}",
                    #{
                        session: session.id,
                        result: result.text,
                        metadata: result.metadata(),
                    },
                );
                watermark(Mark::session(session), SCAN_SESSIONS_KEY).await?;
            }
            Err(err) => {
                log::error!("agent error: {err:?}");
            }
        }
        progress.tick();
    }
}

async fn skip_session(s) {
    if s
        .messages()
        .type(#{ assistant: "tool_use", user: "tool_result" })
        .await?
        .iter()
        .any(edits_files)
    {
        Ok(None)
    } else {
        Ok(Some("no file edits"))
    }
}

fn edits_files(m) {
    uses_edit_tool(m) || bash_edit(m)
}

fn uses_edit_tool(m) {
    m
        .as_object()
        .message
        .content
        .iter()
        .any(
            |block| {
                block.type == "tool_use" && ["Edit", "Write", "MultiEdit"]
                    .iter()
                    .any(|n| n == block.name)
            },
        )
}

fn bash_edit(m) {
    if let Some(result) = m.as_object().get("toolUseResult") {
        if result is Object {
            if let Some(diff) = result.get("bashEditDiff") {
                return !diff.changedFiles.is_empty();
            }
        }
    }
    false
}

async fn summary_notes_by_attachment() {
    Ok(
        scan()
            .notes()
            .names(SUMMARY_NOTES)
            .await?
            .iter()
            .fold(
                #{},
                |acc, n| {
                    if let Some(attachment_id) = attachment_target(n) {
                        if let Some(l) = acc.get(attachment_id) {
                            l.push(n);
                        } else {
                            acc.insert(attachment_id, [n]);
                        }
                    }
                    acc
                },
            ),
    )
}

fn attachment_target(note) {
    match note.target?.split_once(":") {
        Some(("attachment", id)) => Some(id),
        _ => None,
    }
}

async fn session_summaries(session, summary_notes) {
    Ok(
        session
            .attachments()
            .names(PROJECT_ATTACHMENTS)
            .await?
            .fold(
                [],
                |acc, a| {
                    if let Some(notes) = summary_notes.get(a.id) {
                        acc.extend(notes);
                    }
                    acc
                },
            ),
    )
}

fn finding_tool() {
    Tool::new("Finding", write_finding)
        .description("Write a code quality finding about the session")
        .input(
            Input::string("description")
                .description("Finding description")
                .required(),
        )
        .input(Input::string("session_id").required())
        .input(
            Input::string("lines")
                .description(
                    "Session line numbers associated with the finding: \
                     a line (`112`), a range (`61-72`), or a \
                     comma-separated list (`28,31`)",
                ),
        )
}

pub async fn write_finding(inputs) {
    let lines = inputs.get("lines").unwrap_or("");
    let note = write_note("code-review[finding]", inputs.description)
        .target(Target::session_lines(inputs.session_id, lines))
        .metadata(#{ lines })
        .carry_forward_key(SCAN_SESSIONS_KEY)
        .await?;
    Ok(format!("Wrote finding note {}", note.id))
}

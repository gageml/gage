use std::collections::{HashMap, HashSet};

use gage::{
    AgentRunner,
    Files,
    Input,
    Mark,
    Progress,
    Template,
    Tool,
    attach,
    call_agent,
    carry_forward_notes,
    dataset,
    scan,
    tools::Query,
    watermark,
    write_note,
};

pub const SCANNER = #{
    name: "code-review-2",
    description: "Code quality and project rule violations",
    groups: ["default"],
    tasks: #{
        project_files: #{
            attaches: ["project-rule-files", "project-stack-files"],
        },
        summarize_projects: #{
            attachments: #{
                wants: ["project-rule-files", "project-stack-files"],
            },
            notes: #{
                writes: #{
                    "rules[project-summary]": "Summary of a project's rules",
                    "stack[project-summary]": "Summary of a project's stack and architecture",
                },
            },
        },
        review: #{
            attachments: #{
                wants: ["project-rule-files", "project-stack-files"],
            },
            notes: #{
                wants: ["rules[project-summary]", "stack[project-summary]"],
                writes: #{
                    "code-review[finding]": include_str!(
                        "finding-note-doc.md"
                    ),
                },
            },
        },
    },
};

const SUMMARY_KEY = ("code-review", "summarize-projects", 1);
const REVIEW_KEY = ("code-review", "review", 1);

const RULE_FILES = [
    "CLAUDE.md",
    "CLAUDE.local.md",
    ".claude/settings.json",
    ".claude/settings.local.json",
    ".claude/rules/**/*.md",
    ".claude/skills/**/SKILL.md",
    ".claude/commands/**/*.md",
    ".claude/agents/**/*.md",
];

const STACK_FILES = [
    "Cargo.toml",
    "package.json",
    "pyproject.toml",
    "go.mod",
    "Gemfile",
    "pom.xml",
    "build.gradle",
    "mix.exs",
    "deno.json",
    "composer.json",
    "requirements.txt",
    "justfile",
    "Makefile",
];

const PROJECT_ATTACHMENTS = ["project-rule-files", "project-stack-files"];
const SUMMARY_NOTES = ["rules[project-summary]", "stack[project-summary]"];

pub async fn project_files() {
    for (dir, sessions) in sessions_by_project().await {
        attach(Files::include(RULE_FILES).root(dir))
            .name("project-rule-files")
            .targets(sessions)
            .await?;
        attach(Files::include(STACK_FILES).root(dir))
            .name("project-stack-files")
            .targets(sessions)
            .await?;
    }
}

async fn sessions_by_project() {
    let by_project = HashMap::new();
    for s in dataset().sessions().await {
        if let Some(native) = s.native().await {
            if let Some(dir) = native.project_dir {
                if let Some(sessions) = by_project.get(dir) {
                    sessions.push(s);
                } else {
                    by_project.insert(dir, [s]);
                }
            }
        }
    }
    by_project
}

pub async fn summarize_projects() {
    let t = Template::new(include_str!(
        "summarize-project-prompt.md.j2"
    ))?;

    carry_forward_notes(SUMMARY_KEY).await?;

    let unseen = scan()
        .attachments()
        .names(PROJECT_ATTACHMENTS)
        .unseen(SUMMARY_KEY)
        .await?;
    let projects = attachments_by_project(unseen);
    let progress = Progress::new(projects.len());
    let agents = AgentRunner::new();

    for (project, attachments) in projects {
        let attachment_ids = attachments.iter().map(|a| a.id).collect::<Vec>();
        let sections = project_sections(attachments).await?;
        if sections.is_empty() {
            log::info!("project {}: no project files", project);
            watermark_attachments(attachment_ids, SUMMARY_KEY).await?;
            progress.tick();
            continue;
        }
        let prompt = t.render(#{ project, sections })?;
        agents.add(
            call_agent(prompt)
                .name("project-summary")
                .tool(summary_tool())
                .model("medium"),
            #{ project, attachment_ids },
        );
    }

    let results = agents.start();
    while let Some(next) = results.next().await {
        match next {
            Ok((result, #{ project, attachment_ids })) => {
                log::info!(
                    "project-summary: {:?}",
                    #{
                        project,
                        result: result.text,
                        metadata: result.as_metadata(),
                    },
                );
                watermark_attachments(attachment_ids, SUMMARY_KEY).await?;
            }
            Err(err) => {
                log::error!("agent error: {err:?}");
            }
        }
        progress.tick();
    }
}

/// The attachments grouped by the project directory they were
/// selected under: one agent call per project, whatever subset of its
/// attachments is unseen.
fn attachments_by_project(attachments) {
    let by_project = HashMap::new();
    for a in attachments {
        if let Some(list) = by_project.get(a.root) {
            list.push(a);
        } else {
            by_project.insert(a.root, [a]);
        }
    }
    by_project
}

async fn project_sections(attachments) {
    let sections = [];
    for a in attachments {
        let files = [];
        for key in a.files().await {
            let f = a.file(key).await.unwrap();
            files.push(#{ path: key, text: f.text()? });
        }
        if !files.is_empty() {
            sections.push(#{ attachment: a.name.unwrap(), attachment_id: a.id, files });
        }
    }
    Ok(sections)
}

async fn watermark_attachments(attachment_ids, key) {
    for id in attachment_ids {
        watermark(Mark::attachment(id), key).await?;
    }
    Ok(())
}

fn summary_tool() {
    Tool::new("ProjectSummary", write_summary)
        .description("Write a project summary note")
        .input(
            Input::string("name")
                .description("Note name as directed by the prompt")
                .required(),
        )
        .input(
            Input::string("attachment_id")
                .description("Attachment ID as directed by the prompt")
                .required(),
        )
        .input(
            Input::string("summary").description("Summary content").required(),
        )
}

pub async fn write_summary(inputs) {
    if !SUMMARY_NOTES.iter().any(|n| n == inputs.name) {
        return Ok(format!("error: unknown note name `{}`", inputs.name));
    }
    let note = write_note(inputs.name, inputs.summary)
        .for_attachment(inputs.attachment_id)
        .carry_forward_key(SUMMARY_KEY)
        .await?;
    Ok(format!("Wrote summary note {}", note.id))
}

pub async fn review() {
    let t = Template::new(include_str!("review-prompt.md.j2"))?;

    carry_forward_notes(REVIEW_KEY).await?;

    let sessions = scan().sessions().unseen(REVIEW_KEY).await?;
    let progress = Progress::new(sessions.len());
    let agents = AgentRunner::new();
    for (s, (start, end)) in sessions {
        if let Some(reason) = skip_session(s).await? {
            log::info!("skip session {}: {}", s.id, reason);
            watermark(Mark::session(s), REVIEW_KEY).await?;
            progress.tick();
            continue;
        }
        let summaries = project_summaries(s).await?;
        let session_id = s.id;
        let prompt = t.render(#{ session_id, summaries })?;
        agents.add(
            call_agent(prompt)
                .name("code-review")
                .tool(finding_tool())
                .tool(Query::with_session_range(s, start, end))
                .model("medium"),
            #{ session_id },
        );
    }

    let results = agents.start();
    while let Some(next) = results.next().await {
        match next {
            Ok((result, #{ session_id })) => {
                log::info!(
                    "code-review findings: {:?}",
                    #{
                        session: session_id,
                        result: result.text,
                        metadata: result.as_metadata(),
                    },
                );
                watermark(Mark::session(session_id), REVIEW_KEY).await?;
            }
            Err(err) => {
                log::error!("agent error: {err:?}");
            }
        }
        progress.tick();
    }
}

/// The summary notes of the session's project: the notes targeting
/// the project attachments the session is a target of. A session with
/// no project attachments has none, and is reviewed without them.
async fn project_summaries(s) {
    let targets = HashSet::new();
    for a in s.attachments().names(PROJECT_ATTACHMENTS).await? {
        targets.insert(format!("attachment:{}", a.id));
    }
    let out = [];
    for n in scan().notes().names(SUMMARY_NOTES).await? {
        if let Some(target) = n.target {
            if targets.contains(target) {
                out.push(#{ name: n.name, value: n.value });
            }
        }
    }
    Ok(out)
}

const FILE_EDIT_TOOLS = ["Edit", "Write", "MultiEdit"];

async fn skip_session(s) {
    for m in s.messages().type(#{ assistant: "tool_use" }).await? {
        for block in m.as_object().message.content {
            if block.type == "tool_use" && FILE_EDIT_TOOLS
                .iter()
                .any(|t| t == block.name)
            {
                return Ok(None);
            }
        }
    }
    Ok(Some("no file edits"))
}

fn finding_tool() {
    Tool::new("Finding", write_finding)
        .description("Write a code quality finding about the session")
        .input(
            Input::string("description")
                .description("Finding description")
                .required(),
        )
        .input(Input::string("session_id").required())
        .input(
            Input::string("lines")
                .description(
                    "Session line numbers associated with the finding: \
                     a line (`112`), a range (`61-72`), or a \
                     comma-separated list (`28,31`)",
                ),
        )
}

pub async fn write_finding(inputs) {
    let lines = inputs.get("lines").unwrap_or("");
    let note = write_note("finding.code", inputs.description)
        .for_session_lines(inputs.session_id, lines)
        .metadata(#{ lines })
        .carry_forward_key(REVIEW_KEY)
        .await?;
    Ok(format!("Wrote finding note {}", note.id))
}

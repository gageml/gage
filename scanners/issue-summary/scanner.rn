use gage::{global, scan, write_note};

pub const SCANNER = #{
    name: "issue-summary",
    description: "
Write issue-summary note at the end of a scan

Note includes counts of all open and pending issues not just those
written for the scan.
",
    tasks: #{
        main: #{
            issues: #{ wants: ["*"] },
            notes: #{
                writes: #{
                    "issue-summary": include_str!(
                        "issue-summary-note.md"
                    ),
                },
            },
        },
    },
};

pub async fn main() {
    let open = global().issues().status("open").await?.len();
    let pending = global().issues().status("pending").await?.len();
    write_note(
        #{
            name: "issue-summary",
            value: open + pending,
            target: #{ scan: scan().id },
            metadata: #{ open: open, pending: pending },
        },
    )
    .await?;
    Ok(())
}

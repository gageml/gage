use gage::{Fail, Files, attach, scan, write_issue};

pub const SCANNER = #{
    name: "session-retention-2",
    description: "Highlight unset session retention policy",
    groups: ["default"],
    attachments: #{ "claude-config": #{} },
    tasks: #{
        check: #{
            attachments: #{ needs: ["claude-config"] },
            issues: #{
                writes: #{
                    "session-retention": "Session retention policy is unset",
                },
            },
        },
    },
};

const SETTINGS = ["settings.json", "settings.local.json"];

pub async fn attach_claude_config() {
    attach(Files::include(SETTINGS).root("~/.claude"))
        .name("claude-config")
        .await?;
}

pub async fn check() {
    if let Some(val) = cleanup_period_days().await? {
        log::info!("cleanupPeriodDays set ({val} days)");
    } else {
        write_issue(
            "session-retention",
            "Unset session retention policy",
            include_str!("issue.md"),
        )
        .key("session-retention")
        .once()
        .await?;
    }
}

async fn cleanup_period_days() {
    let a = scan()
        .attachments()
        .name("claude-config")
        .await?
        .next()
        .ok_or(Fail("dataset missing claude-code attachment"))?;
    for name in SETTINGS {
        if let Some(f) = a.file(name).await {
            let settings = f.json().expect("should be JSON");
            if let Some(val) = settings.get("cleanupPeriodDays") {
                return Ok(Some(val))
            }
        }
    }
    Ok(None)
}

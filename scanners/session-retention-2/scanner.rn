// Model of the `session-retention` scanner for the rethink runtime
// (`gage-scan2` and `gage-runtime2`). The scanner names the subject;
// the task names the action.
//
// The user config reaches the scan as a dataset attachment named
// `claude-config`, added with `gage attachment add claude-config
// settings.json --root ~/.claude --dataset <DATASET>`. The scan reads
// the attachment at the commit its dataset links.

use gage::{scan, write_issue};

pub const SCANNER = #{
    name: "session-retention-2",
    description: "Highlight unset session retention policy",
    // FUTURE: groups: ["default"] when this scanner replaces
    // `session-retention`. Left out so a legacy default scan does not
    // select it.
    tasks: #{
        check: #{
            issues: #{
                writes: #{
                    "session-retention": "Session retention policy is unset",
                },
            },
        },
    },
};

/// Report an unset retention policy in the user config.
///
/// Reads `settings.json` from the `claude-config` attachment. Without
/// the attachment or the file there is nothing to check. The issue is
/// written once: a later scan that finds it in any status, closed
/// included, writes nothing.
pub async fn check() {
    for a in scan().attachments().name("claude-config").await {
        let settings = match a.file("settings.json").await {
            Some(f) => f.json()?,
            None => {
                log::info!("claude-config has no settings.json; skipping");
                continue;
            }
        };
        if settings.get("cleanupPeriodDays").is_some() {
            continue;
        }
        write_issue(
            "session-retention",
            "Unset session retention policy - sessions may be unexpectedly deleted",
            include_str!("issue.md"),
        )
        .keep_named()
        .await?;
    }
    Ok(())
}

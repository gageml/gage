// Model of the `session-retention` scanner for the rethink runtime
// (`gage-scan2` and `gage-runtime2`). The scanner names the subject;
// the task names the action.
//
// The user config reaches the scan as a dataset attachment named
// `claude-config`. The scanner's attachment function adds it when the
// dataset is prepared with `gage attachment add -s session-retention-2
// -d <DATASET>`; the scan reads it at the commit its dataset links.

use gage::{Fail, Files, attach, scan, write_issue};

pub const SCANNER = #{
    name: "session-retention-2",
    description: "Highlight unset session retention policy",
    groups: ["default"],
    attachments: #{
        "claude-config": #{},
    },
    tasks: #{
        check: #{
            attachments: #{ needs: ["claude-config"] },
            issues: #{
                writes: #{
                    "session-retention": "Session retention policy is unset",
                },
            },
        },
    },
};

pub async fn attach_claude_config() {
    attach(Files::include(["settings.json", "settings.local.json"]).root("~/.claude"))
        .name("claude-config")
        .await?;
}

pub async fn check() {
    if let Some(days) = attached_settings().await?.get("cleanupPeriodDays") {
        log::info!("cleanupPeriodDays set ({} days)", days);
    } else {
        write_issue(
            "session-retention",
            "Unset session retention policy",
            include_str!("issue.md"),
        )
        .key("session-retention")
        .once()
        .await?;
    }
}

async fn attached_settings() {
    Ok(
        scan()
            .attachments()
            .name("claude-config")
            .await?
            .next()
            .ok_or(Fail(
                "attachment claude-config is not in the dataset; add it with \
                 `gage attachment add -s session-retention-2 -d <DATASET>`",
            ))?
            .file("settings.json")
            .await
            .expect("claude-config attachment should have settings.json")
            .json()
            .expect("settings.json should be valid JSON"),
    )
}

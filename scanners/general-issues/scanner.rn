use gage::tools::{IssueWrite, Query};
use gage::{
    AgentRunner,
    Template,
    call_agent,
    carry_forward_notes,
    query,
    scan,
    write_note,
};

pub const SCANNER = #{
    name: "general-issues",
    description: "Scan sessions for general issues",
    tasks: #{
        findings: #{
            notes: #{
                writes: #{ "finding": "Noteworthy finding in a session" },
            },
        },
        issues: #{
            notes: #{ wants: ["finding"] },
            issues: #{
                writes: #{
                    "general": "General issue derived from session findings",
                },
            },
        },
    },
};

const FINDINGS_KEY = ("general-issues", "findings", 3);

/// Submit each session to an agent to write findings.
///
/// Sessions already processed under the current findings key are
/// skipped; their prior findings are carried forward into this scan.
pub async fn findings() {
    // Skip previously scanned sessions per key
    let (prev_sessions, new_sessions, validate) = scan()
        .sessions()
        .split_valid(FINDINGS_KEY)
        .await?;
    carry_forward_notes(prev_sessions, ["finding"]).await?;

    // Init template for agent prompts
    let t = Template::new(include_str!("findings-prompt.md.j2")).await?;

    // Use agent runner to scan sessions concurrently
    let runner = AgentRunner::new();
    for s in new_sessions {
        // Skip sessions that not likely to have scannable content
        if let Some(reason) = skip_session(s).await? {
            log::info!("Skipping session {}: {}", s.id, reason);
            validate(s)?;
            continue
        }
        // Queue agent
        let prompt = t.render(#{ session_id: s.id }).await?;
        runner.add(
            call_agent(prompt)
                .name("session-finding")
                .gage_tools([Query::new().scan(scan().id)])
                .tools(findings_tools())
                .model("medium"),
            #{ session: s.id },
        );
    }

    // Run agents
    let results = runner.start();

    // Collect results
    loop {
        match results.next().await {
            Some(Ok((result, #{ session }))) => {
                log::info!(
                    "findings: {:?}",
                    #{
                        session,
                        result: result.text,
                        metadata: result.as_metadata(),
                    },
                );
                // Ensure that valid sessions aren't re-scanned
                validate(session)?;
            }
            None => break,
        }
    }

    Ok(())
}

/// Min total text length to scan session
const SESSION_MIN_TEXT_LEN = 200;

async fn skip_session(s) {
    // Use query instead of iterating over messages to keep scanner
    // memory use down for this test. Limit sum to 50 messages for
    // same reason.
    let result = query(
        format!(
            "SELECT sum(length(text)) AS text_len FROM \
            (SELECT text FROM message WHERE session_id = '{}' LIMIT 50)",
            s.id
        ),
    )
    .await?;
    let #{ text_len } = result.get(0).expect("should return one row");
    match text_len {
        () => Ok(Some("empty session")),
        text_len if text_len < SESSION_MIN_TEXT_LEN => {
            let reason = format!(
                "text len {text_len} < min {SESSION_MIN_TEXT_LEN}"
            );
            Ok(Some(reason))
        }
        _ => Ok(None),
    }
}

fn findings_tools() {
    #{
        write_finding: #{
            name: "Finding",
            description: "Write a finding about the session",
            inputs: #{
                description: #{
                    type: "string",
                    description: "Finding description",
                },
                session: #{ type: "string", description: "Session ID" },
                lines: #{
                    type: "string",
                    description: "Session line numbers associated with the finding",
                    required: false,
                },
            },
        },
    }

}

pub async fn write_finding(inputs, meta) {
    let metadata = #{};
    if let Some(lines) = inputs.get("lines") {
        metadata.insert("lines", lines)
    }
    let note = write_note(
        #{
            name: "finding",
            author: meta.to_author(),
            value: inputs.description,
            target: #{ session: inputs.session },
            metadata,
        },
    )
    .await?;
    Ok(format!("Wrote finding {}", note.id))
}

const ISSUES_KEY = ("general-issues", "issues", 1);

const NEW_FINDINGS_THRESHOLD = 5;

/// Ask agent to review findings and write issues.
///
/// The findings available to the agent are limited to those written
/// for the current scan. Skips the agent when every finding has
/// already been analyzed under the current issues key.
pub async fn issues() {
    let (prev_findings, new_findings, validate) = scan()
        .notes()
        .names(["finding"])
        .split_valid(ISSUES_KEY)
        .await?;

    let threshold = if prev_findings.is_empty() {
        1
    } else {
        NEW_FINDINGS_THRESHOLD
    };
    if new_findings.len() < threshold {
        return Ok(());
    }

    let agent = call_agent(include_str!("issues-prompt.md"))
        .name("issue-writer")
        .gage_tools(
            [
                Query::new().scan(scan().id),
                IssueWrite::new().scan(scan().id).status("open"),
            ],
        )
        .model("large")
        .await?;
    let result = agent.wait().await?;
    log::info!(
        "issues: {:?}",
        #{
            result: result.text,
            metadata: result.as_metadata(),
        },
    );
    validate().await
}

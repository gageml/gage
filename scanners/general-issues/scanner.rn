use gage::tools::{IssueWrite, Query};
use gage::{AgentRunner, Template, call_agent, carry_forward_notes, scan, write_note};

pub const SCANNER = #{
    name: "general-issues",
    description: "Scan sessions for general issues",
    tasks: #{
        findings: #{
            notes: #{
                writes: #{
                    "finding.general": "Noteworthy finding in a session",
                    "finding-summary.general": "Summary of session findings",
                },
            },
        },
        issues: #{
            notes: #{
                wants: ["finding.general", "finding-summary"],
                writes: #{
                    "issue-summary.general": "Summary of issue writing",
                },
            },
            issues: #{
                writes: #{
                    "general": "General issue derived from session findings",
                },
            },
        },
    },
};

const FINDINGS_KEY = ("general-issues", "findings", 1);

/// Submit each session to an agent to write findings.
///
/// Sessions already processed under the current findings key are
/// skipped; their prior findings are carried forward into this scan.
pub async fn findings() {
    let t = Template::new(include_str!("findings-prompt.md")).await?;
    let runner = AgentRunner::new();
    let (prev_sessions, new_sessions, validate) = scan()
        .sessions()
        .split_valid(FINDINGS_KEY)
        .await?;
    carry_forward_notes(
        prev_sessions,
        ["finding.general", "finding-summary.general"],
    )
    .await?;
    for s in new_sessions {
        let prompt = t.render(#{ session_id: s.id }).await?;
        runner.add(
            call_agent(prompt)
                .name("session-finding")
                .gage_tools([Query::new().scan(scan().id)])
                .tools(findings_tools())
                .model("small"),
            #{ session: s.id },
        );
    }
    let results = runner.start();
    write_summaries(results, validate).await?;
    Ok(())
}

fn findings_tools() {
    #{
        write_finding: #{
            name: "Finding",
            description: "Write a finding about the session",
            inputs: #{
                description: #{
                    type: "string",
                    description: "Finding description",
                },
                session: #{ type: "string", description: "Session ID" },
                lines: #{
                    type: "string",
                    description: "Session line numbers associated with the finding",
                    required: false,
                },
                fix: #{
                    type: "string",
                    description: "Suggested fix or fix strategy where applicable",
                    required: false,
                },
            },
        },
    }

}

pub async fn write_finding(inputs, meta) {
    let metadata = #{};
    if let Some(lines) = inputs.get("lines") {
        metadata.insert("lines", lines)
    }
    if let Some(fix) = inputs.get("fix") {
        metadata.insert("fix", fix);
    }
    let note = write_note(
        #{
            name: "finding.general",
            author: meta.to_author(),
            value: inputs.description,
            target: #{ session: inputs.session },
            metadata,
        },
    )
    .await?;
    Ok(format!("Wrote note {}", note.id))
}

/// Write finding-summary notes for agent results and mark each
/// completed session valid for future scans.
async fn write_summaries(results, validate) {
    loop {
        match results.next().await {
            Some(Ok((result, #{ session }))) => {
                // A re-scan of the same session supersedes its prior
                // summary rather than accumulating one per scan
                write_note(
                    #{
                        name: "finding-summary.general",
                        target: #{ session },
                        value: result.text,
                        metadata: result.as_metadata(),
                    },
                )
                .replace_prev()
                .await?;
                validate(session)?;
            }
            None => break,
        }
    }
    Ok(())
}

const ISSUES_KEY = ("general-issues", "issues", 1);
const NEW_FINDINGS_THRESHOLD = 5;

/// Ask agent to review findings and write issues.
///
/// The findings available to the agent are limited to those written
/// for the current scan. Skips the agent when every finding has
/// already been analyzed under the current issues key.
pub async fn issues() {
    let (prev_findings, new_findings, validate) = scan()
        .notes()
        .names(["finding.general", "finding-summary.general"])
        .split_valid(ISSUES_KEY)
        .await?;

    let threshold = if prev_findings.is_empty() {
        1
    } else {
        NEW_FINDINGS_THRESHOLD
    };
    if new_findings.len() < threshold {
        return Ok(());
    }

    let agent = call_agent(include_str!("issues-prompt.md"))
        .name("issue-writer")
        .gage_tools(
            [
                Query::new().scan(scan().id),
                IssueWrite::new().scan(scan().id),
            ],
        )
        .model("large")
        .await?;
    let result = agent.wait().await?;
    write_note(
        #{
            name: "issue-summary.general",
            value: result.text,
            target: #{ scan: scan().id },
            metadata: result.as_metadata(),
        },
    )
    .await?;

    validate().await
}

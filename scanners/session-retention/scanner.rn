use gage::{write_note, write_issue, scan, user};

pub const SCANNER = #{
    name: "session-retention",
    description: "Highlight unset session retention policy",
    groups: ["default"],
    tasks: #{
        note_and_issue: #{
            notes: #{
                writes: #{
                    "session-retention-policy.unset": include_str!(
                        "unset-policy-note.md"
                    ),
                },
            },
            issues: #{
                writes: #{
                    "session-retention": "Session retention policy is unset",
                },
            },
        },
    },
};

pub async fn note_and_issue() {
    let setting = user().config().await.get("cleanupPeriodDays");
    if setting.is_none() {
        let note = write_note(
            #{
                name: "session-retention-policy.unset",
                value: true,
                target: #{ scan: scan().id },
            },
        )
        .keep_prev()
        .await?;
        write_issue(
            #{
                name: "session-retention",
                title: "Unset session retention policy - sessions may be unexpected deleted",
                description: "scanner:/session-retention/issue.md",
                evidence: [#{ note, timestamp: note.created }],
            },
        )
        .keep_status()
        .await?;

    }
    Ok(())
}

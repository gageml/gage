use gage::{call_agent, scan, write_note};

pub const SCANNER = #{
    name: "tool-error",
    description: "Highlight tool use errors",
    tasks: #{
        note: #{
            notes: #{
                writes: #{
                    "msg.tool_error": include_str!(
                        "tool-error-note.md"
                    ),
                },
            },
        },
        judge: #{
            notes: #{
                wants: ["msg.tool_error"],
                writes: #{
                    "judge.tool-error": include_str!(
                        "judge-note.md"
                    ),
                },
            },
        },
    },
};

pub async fn note() {
    let tool_names = #{};

    for s in scan().sessions() {
        for msg in s.messages().of_type(#{ assistant: "tool_use" }).await? {
            for block in content_blocks(msg) {
                if block_type(block) != "tool_use" {
                    continue;
                }
                let name = match block.get("name") {
                    Some(n) if n is String => n,
                    _ => "<unknown>",
                };
                match block.get("id") {
                    Some(id) if id is String => tool_names[id] = name,
                    _ => {}
                }
            }
        }

        for msg in s.messages().of_type(#{ "user": "tool_result" }).await? {
            for block in content_blocks(msg) {
                if block_type(block) != "tool_result" {
                    continue;
                }
                let is_err = block.get("is_error") == Some(true);
                if is_err {
                    let tool_name = match block.get("tool_use_id") {
                        Some(id) if id is String => match tool_names.get(id) {
                            Some(n) => n,
                            None => "<unknown>",
                        },
                        _ => "<unknown>",
                    };
                    let content = format!(
                        "{}", block.get("content").unwrap_or("<undefined>")
                    );
                    if is_user_rejection(content) {
                        continue;
                    }
                    let value = format!("{tool_name}: {}", truncate(content, 150, 100));
                    write_note(
                        #{
                            name: "msg.tool_error",
                            value,
                            target: #{ session: s.id, line: msg.line },
                        },
                    )
                    .replace_prev()
                    .await?;
                }
            }
        }
    }
}

// Return the `message.content` array of a message as a Vec of blocks,
// or an empty Vec when the field is absent or malformed.
fn content_blocks(msg) {
    let obj = msg.as_object();
    let m = match obj.get("message") {
        Some(v) if v is Object => v,
        _ => return [],
    };
    match m.get("content") {
        Some(v) if v is Vec => v,
        _ => [],
    }
}

// Bound a value to its first `head` and last `tail` characters, joined by an
// ellipsis, so bulk `SELECT value` stays under the query size cap. Errors
// front-load their signal (e.g. "File has not been read yet") while Bash
// output and tracebacks carry theirs at the tail, so keep both ends.
fn truncate(s, head, tail) {
    let chars = s.chars().collect::<Vec>();
    let total = chars.len();
    if total <= head + tail + 1 {
        return s;
    }
    let h = "";
    let t = "";
    let i = 0;
    for c in chars {
        if i < head {
            h.push(c);
        } else if i >= total - tail {
            t.push(c);
        }
        i = i + 1;
    }
    format!("{h} … {t}")
}

// A user rejection ("doesn't want to proceed" / "tool use was rejected") is
// recorded as a tool_result error, but it is not a tool failure. The user
// declined the action; these belong to the `tool-rejection` scanner.
fn is_user_rejection(content) {
    content.contains("doesn't want to proceed")
        || content.contains("tool use was rejected")
}

// Return a block's `type` field as a string, or empty when absent.
fn block_type(block) {
    if block is not Object {
        return "";
    }
    match block.get("type") {
        Some(v) if v is String => v,
        _ => "",
    }
}

const JUDGE_PROMPT = include_str!("judge-prompt.md");

pub async fn judge() {
    let agent = call_agent(JUDGE_PROMPT).allow_tools(["IssueOpen"]).await?;
    let out = agent.wait().await?;
    write_note(
        #{
            name: "judge.tool-error",
            target: #{ scan: scan().id },
            value: out.stdout,
            metadata: #{
                success: out.status.success,
                exit_code: out.status.code,
                stderr: out.stderr,
            },
        },
    )
    .await?
}

use gage::{Ignore, write_note, write_issue, user, scan};

pub const SCANNER = #{
    name: "hidden-thinking",
    description: "
Detect sessions where model thinking is hidden

Thinking blocks provide important evidence of model thinking and
should be visible. Unfortunately, the default settings for Claude
Code cause thinking blocks to be hidden. This scanner looks for this
consition and recommends fixes for issues it finds.
",
    tasks: #{
        note: #{
            notes: #{
                writes: #{
                    "thinking.empty": include_str!(
                        "thinking-empty-note.md"
                    ),
                },
            },
        },
        issue: #{ notes: #{ wants: ["thinking.empty"] } },
    },
};

pub async fn note() {
    let config = format!(
        "{{\"showThinkingSummaries\": {}}}",
        user().config().await.get("showThinkingSummaries").unwrap_or("null")
    );
    // Find the latest thinking block across all sessions. Sessions are
    // ordered newest-modified first and a session's thinking blocks are
    // no newer than its modified time, so stop once a session's modified
    // time can't beat the best candidate.
    let latest = None;
    for s in scan().sessions() {
        if let Some((best, _)) = latest {
            if s.modified.millis() <= best.timestamp.millis() {
                break;
            }
        }
        for msg in s
            .messages()
            .type(#{ "assistant": "thinking" })
            .latest_first() // only check latest thinking block
            .await?
        {
            let newer = match latest {
                Some((best, _)) => msg.timestamp.millis() > best.timestamp.millis(),
                None => true,
            };
            if newer {
                latest = Some((msg, s.id));
            }
            // Stop after the session's latest block
            break;
        }
    }
    if let Some((msg, session_id)) = latest {
        write_note(
            #{
                name: "thinking.empty",
                value: msg.text == "",
                target: #{ session: session_id, line: msg.line },
                metadata: #{
                    msg_timestamp: msg.timestamp.millis(),
                    model: msg.model(),
                    config,
                },
            },
        )
        .keep_prev() // target is session line so naturally advances
        .await?;
    }
    Ok(())
}

pub async fn issue() {
    // Use the most recent thinking.empty block for evidence
    let note = latest_evidence().await?.ok_or(Ignore)?;

    // Only report issues for empty text (value is true)
    if note.value {
        let timestamp = note.metadata.get("msg_timestamp").unwrap();
        write_issue(
            #{
                name: "hidden-thinking",
                title: "Thinking blocks hidden in recent session",
                description: "scanner:/hidden-thinking/issue.md",
                evidence: [#{ note, timestamp }],
            },
        )
        .open_on_new_evidence()
        .await?;
    }
    Ok(())
}

async fn latest_evidence() {
    let notes = scan().notes().name("thinking.empty").await?;
    if notes.is_empty() {
        return Ok(None);
    }
    let cmp = |a, b| {
        let a_ts = a.metadata.get("msg_timestamp").unwrap();
        let b_ts = b.metadata.get("msg_timestamp").unwrap();
        assert!(a_ts != 0 && b_ts != 0);
        b_ts.cmp(a_ts)
    };
    notes.sort_by(cmp);
    Ok(Some(notes[0]))
}

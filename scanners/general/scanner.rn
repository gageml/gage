use gage::tools::Query;
use gage::{
    AgentRunner,
    Progress,
    Template,
    call_agent,
    model_context,
    params,
    query,
    scan,
    write_note,
};

pub const SCANNER = #{
    name: "general",
    description: "Scan sessions for general findings",
    groups: ["default"],
    config: #{
        mode: #{ value: "roadmap" },
    },
    tasks: #{
        findings: #{
            notes: #{
                writes: #{
                    "finding.general": include_str!("finding-general-doc.md"),
                },
            },
        },
    },
};

const FINDINGS_KEY = ("general", "findings", 1);
const FINDINGS_ROADMAP_KEY = ("general", "findings[roadmap]", 1);

/// Submit each session to an agent to write finding notes.
///
/// The `mode` param selects the scan variant. Each mode validates
/// sessions under its own key, so modes never mask each other's work.
/// Both modes write `finding.general` notes; the note's `mode`
/// metadata records the variant.
pub async fn findings() {
    match params().mode {
        "query" => findings_query().await,
        "roadmap" => findings_roadmap().await,
        other => Err(format!(
            "unsupported mode `{other}`: expected `query` or `roadmap`"
        )),
    }
}

/// Query mode: the agent reads the session through its Query view.
///
/// Sessions already processed under the current findings key are
/// skipped. A grown session carries the range of its unscanned lines;
/// the agent's Query view is constrained to that range.
async fn findings_query() {
    // Skip previously scanned sessions per key
    let (_prev_sessions, new_sessions, validate) = scan()
        .sessions()
        .split_valid_range(FINDINGS_KEY)
        .await?;

    // Init template for agent prompts
    let t = Template::new(include_str!("findings-prompt.md.j2")).await?;

    // One tick per session: skipped sessions tick during queueing,
    // scanned sessions tick as their agents complete
    let progress = Progress::new(new_sessions.len());

    // Use agent runner to scan sessions concurrently
    let runner = AgentRunner::new();
    for s in new_sessions {
        // Skip sessions that not likely to have scannable content
        if let Some(reason) = skip_session(s).await? {
            log::info!("Skipping session {}: {}", s.id, reason);
            validate(s).await?;
            progress.tick();
            continue
        }
        // Queue agent
        let prompt = t.render(#{ session_id: s.id }).await?;
        runner.add(
            call_agent(prompt)
                .name("session-finding")
                // The agent sees this session only, clipped to
                // s.range when it is Some
                .gage_tools([Query::new().sessions([s])])
                .tools(#{ write_finding: write_finding_tooldef() })
                .model("medium"),
            #{ session: s.id },
        );
    }

    // Run agents
    let results = runner.start();

    // Collect results
    loop {
        match results.next().await {
            Some(Ok((result, #{ session }))) => {
                log::info!(
                    "findings: {:?}",
                    #{
                        session,
                        result: result.text,
                        metadata: result.as_metadata(),
                    },
                );
                // Ensure that valid sessions aren't re-scanned
                validate(session).await?;
                progress.tick();
            }
            None => break,
        }
    }

    Ok(())
}

// Duplicates the value caps of the retired `Session::roadmap()`
// renderer; tuning toward the evidence-based values is a later step
// (see the agent query behavior appendix in the design doc)
const ROADMAP_RULES = [
    ("user.text",          #{ max: 500 }),
    ("assistant.text",     #{ max: 500 }),
    ("assistant.thinking", #{ max: 500, priority: ["start", "end"] }),
    ("tool_use",           #{ max: 200 }),
    ("tool_result",        #{ max: 200, priority: ["line1"] }),
    ("*",                  #{ max: 200 }),
];

/// Roadmap mode: the whole session goes into the agent prompt as a
/// compressed session; the agent retrieves full message text
/// selectively through its session-scoped Query view.
///
/// Sessions already processed under the current findings key are
/// skipped. A grown session carries the range of its unscanned lines;
/// the compressed session and Query view are constrained to that
/// range.
async fn findings_roadmap() {
    // Skip previously scanned sessions per key
    let (_prev_sessions, new_sessions, validate) = scan()
        .sessions()
        .split_valid_range(FINDINGS_ROADMAP_KEY)
        .await?;

    // Size the compression budget to the agent's free context
    let context = model_context("medium").await?;
    let budget = (context.free_tokens as f64) * 0.8;

    // Init template for agent prompts
    let t = Template::new(include_str!("findings-roadmap-prompt.md.j2")).await?;

    // One tick per session: skipped sessions tick during queueing,
    // scanned sessions tick as their agents complete
    let progress = Progress::new(new_sessions.len());

    // Use agent runner to scan sessions concurrently
    let runner = AgentRunner::new();
    for s in new_sessions {
        // Skip sessions that are not likely to have scannable content
        if let Some(reason) = skip_session(s).await? {
            log::info!("Skipping session {}: {}", s.id, reason);
            validate(s).await?;
            progress.tick();
            continue
        }
        let roadmap = s.compress(budget, ROADMAP_RULES).await?;
        let prompt = t.render(#{ session_id: s.id, roadmap }).await?;
        runner.add(
            call_agent(prompt)
                .name("session-finding-roadmap")
                // The agent sees this session only, clipped to
                // s.range when it is Some
                .gage_tools([Query::new().sessions([s])])
                .tools(#{ write_finding_roadmap: write_finding_tooldef() })
                .model("medium"),
            #{ session: s.id },
        );
    }

    // Run agents
    let results = runner.start();

    // Collect results
    loop {
        match results.next().await {
            Some(Ok((result, #{ session }))) => {
                log::info!(
                    "roadmap findings: {:?}",
                    #{
                        session,
                        result: result.text,
                        metadata: result.as_metadata(),
                    },
                );
                // Ensure that valid sessions aren't re-scanned
                validate(session).await?;
                progress.tick();
            }
            None => break,
        }
    }

    Ok(())
}

/// Min total text length to scan session
const SESSION_MIN_TEXT_LEN = 200;

async fn skip_session(s) {
    // Use query instead of iterating over messages to keep scanner
    // memory use down for this test. Limit sum to 50 messages for
    // same reason.
    let result = query(
        format!(
            "SELECT sum(length(text)) AS text_len FROM \
            (SELECT text FROM message WHERE session_id = '{}' LIMIT 50)",
            s.id
        ),
    )
    .await?;
    let #{ text_len } = result.get(0).expect("should return one row");
    match text_len {
        () => Ok(Some("empty session")),
        text_len if text_len < SESSION_MIN_TEXT_LEN => {
            let reason = format!(
                "text len {text_len} < min {SESSION_MIN_TEXT_LEN}"
            );
            Ok(Some(reason))
        }
        _ => Ok(None),
    }
}

fn write_finding_tooldef() {
    #{
        name: "Finding",
        description: "Write a finding about the session",
        inputs: #{
            description: #{
                type: "string",
                description: "Finding description",
            },
            session: #{ type: "string", description: "Session ID" },
            lines: #{
                type: "string",
                description: "Session line numbers associated with the finding: \
                              a line (`112`), a range (`61-72`), or a \
                              comma-separated list (`28,31`)",
                required: false,
            },
        },
    }
}

// Tool callbacks run without task params (the dispatcher clears them),
// so each mode registers its own callback carrying its mode.

pub async fn write_finding(inputs, meta) {
    write_finding_note("query", inputs, meta).await
}

pub async fn write_finding_roadmap(inputs, meta) {
    write_finding_note("roadmap", inputs, meta).await
}

async fn write_finding_note(mode, inputs, meta) {
    let metadata = #{ mode };
    let target = #{ session: inputs.session };
    if let Some(lines) = inputs.get("lines") {
        let (line, line_end) = parse_lines(lines)?;
        target.insert("line", line);
        if let Some(end) = line_end {
            target.insert("line_end", end);
        }
        metadata.insert("lines", lines);
    }
    let note = write_note(
        #{
            name: "finding.general",
            author: meta.agent_tool_use(),
            value: inputs.description,
            target,
            metadata,
        },
    )
    .await?;
    Ok(format!("Wrote finding note {}", note.id))
}

/// Reduce the tool's `lines` input to the target span: the min line
/// and, when the input covers more than one line, the max. A list
/// collapses to its min-max envelope.
fn parse_lines(lines) {
    let nums = [];
    for part in lines.split(',') {
        match part.trim().split_once('-') {
            Some((start, end)) => {
                nums.push(parse_num(start, lines)?);
                nums.push(parse_num(end, lines)?);
            }
            None => nums.push(parse_num(part, lines)?),
        }
    }
    nums.sort();
    let line = nums[0];
    let line_end = nums[nums.len() - 1];
    if line_end > line {
        Ok((line, Some(line_end)))
    } else {
        Ok((line, None))
    }
}

/// One number from the `lines` input. The error names the accepted
/// formats so the agent can rephrase and retry.
fn parse_num(part, lines) {
    match part.trim().parse::<i64>() {
        Ok(n) if n >= 1 => Ok(n),
        _ => Err(format!(
            "unparseable lines `{lines}`: expected a line (`112`), a range \
             (`61-72`), or a comma-separated list (`28,31`)"
        )),
    }
}

#[test]
fn test_parse_lines_single() {
    assert_eq!(parse_lines("112"), Ok((112, None)));
}

#[test]
fn test_parse_lines_range() {
    assert_eq!(parse_lines("61-72"), Ok((61, Some(72))));
}

#[test]
fn test_parse_lines_list_collapses_to_span() {
    assert_eq!(parse_lines("28,31"), Ok((28, Some(31))));
    assert_eq!(parse_lines("80, 28, 31-40"), Ok((28, Some(80))));
}

#[test]
fn test_parse_lines_single_valued_inputs_have_no_end() {
    assert_eq!(parse_lines("7,7"), Ok((7, None)));
    assert_eq!(parse_lines("7-7"), Ok((7, None)));
}

#[test]
fn test_parse_lines_unparseable() {
    for bad in ["", "abc", "12-", "-12", "1;2", "0"] {
        assert!(parse_lines(bad).is_err(), "expected error for `{}`", bad);
    }
}
